<div class="content-head"><div><h1>Cooperatives (tenants)</h1><div class="muted small">Each tenant has its own PostgreSQL schema, uploads folder, admins and members.</div></div></div>
<div class="grid" style="grid-template-columns:minmax(0,1.7fr) minmax(0,1fr);gap:20px">
  <div class="stack">
    <% if (!list.length) { %><div class="empty">No tenants yet — create the first one.</div><% } %>
    <% list.forEach(tn => { %>
      <div class="card" id="tenant-<%= tn.id %>">
        <div class="flex justify-between items-center wrap gap-1">
          <div><h3 class="mb-0"><%= tn.name %> <span class="badge <%= tn.status === 'active' ? 'badge-ok' : 'badge-bad' %>"><%= tn.status %></span></h3>
            <div class="small faint"><code><%= tn.slug %></code> · schema <code><%= tn.schema_name %></code> · <%= tn.stats.members %> members · <%= tn.stats.pending %> pending loans</div></div>
          <div class="flex gap-1">
            <form method="post" action="/platform/tenants/<%= tn.id %>/migrate"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-outline btn-sm">Migrate</button></form>
            <form method="post" action="/platform/tenants/<%= tn.id %>/status"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="status" value="<%= tn.status === 'active' ? 'suspended' : 'active' %>"><button class="btn btn-sm <%= tn.status === 'active' ? 'btn-ghost' : 'btn-soft' %>" data-confirm="<%= tn.status === 'active' ? 'Suspend' : 'Activate' %> <%= tn.slug %>?"><%= tn.status === 'active' ? 'Suspend' : 'Activate' %></button></form>
          </div>
        </div>
        <form method="post" action="/platform/tenants/<%= tn.id %>/license" class="flex gap-1 wrap items-center mt-2">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <span class="small muted">Licence until</span><input class="input" type="date" name="until" value="<%= tn.license.until || '' %>" style="max-width:170px;padding:5px 10px">
          <span class="badge <%= !tn.license.configured ? '' : tn.license.expired ? 'badge-bad' : tn.license.daysLeft <= 30 ? 'badge-warn' : 'badge-ok' %>"><%= !tn.license.configured ? 'no expiry' : tn.license.expired ? 'expired' : tn.license.daysLeft + ' days left' %></span>
          <button class="btn btn-ghost btn-sm">Save</button>
        </form>
        <% (tn.stats.notices || []).forEach(n => { %>
          <form method="post" action="/platform/tenants/<%= tn.id %>/license" class="alert alert-info mt-1 flex gap-1 wrap items-center" style="margin-bottom:0">
            <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="notice_id" value="<%= n.id %>">
            <span class="grow small">Renewal notice: <b><%= n.gateway %></b> · txn <code><%= n.txn_reference %></code> · Rs. <%= n.amount_reported %> · by <%= n.submitted_by_username %><%= n.note ? ' — ' + n.note : '' %></span>
            <input class="input" type="date" name="until" value="<%= tn.license.until || '' %>" style="max-width:170px;padding:5px 10px" required>
            <button class="btn btn-soft btn-sm" name="notice_action" value="clear">Verify &amp; set date</button>
            <button class="btn btn-ghost btn-sm" name="notice_action" value="cancel" formnovalidate>Reject</button>
          </form>
        <% }) %>
        <details class="mt-2" <%= tn.domain_rows.some(d => d.status !== 'active') ? 'open' : '' %>><summary class="small" style="cursor:pointer">Domains (<%= tn.domain_rows.length %>) · CNAME target <code><%= tn.cname_target %></code></summary>
          <div class="mt-1"><%- include('../partials/domains-panel', { target: tn.cname_target, rows: tn.domain_rows, base: '/platform/tenants/' + tn.id + '/domains', redirect: tn.redirect_to_primary, dnsHelp }) %></div>
        </details>
      </div>
    <% }) %>
  </div>
  <form class="form-card" method="post" action="/platform/tenants">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3>New cooperative</h3>
    <% if (errors._) { %><div class="alert alert-error"><%= errors._ %></div><% } %>
    <div class="stack">
      <div class="field"><label>Slug</label><input class="input" name="slug" value="<%= values.slug || '' %>" placeholder="aakash" required pattern="[a-z][a-z0-9_]{1,39}"><div class="field-hint">Subdomain: &lt;slug&gt;.<%= baseDomain %></div></div>
      <div class="field"><label>Name (Nepali)</label><input class="input" name="name" value="<%= values.name || '' %>" required></div>
      <div class="field"><label>Name (English)</label><input class="input" name="name_en" value="<%= values.name_en || '' %>"></div>
      <div class="field"><label>Custom domains (optional)</label><input class="input" name="domains" value="<%= values.domains || '' %>" placeholder="www.coop.com.np, coop.com.np"></div>
      <div class="field"><label>Contact email</label><input class="input" name="contact_email" type="email" value="<%= values.contact_email || '' %>"></div>
      <div class="field"><label>First admin username</label><input class="input" name="admin_username" value="<%= values.admin_username || 'admin' %>"></div>
      <div class="field"><label>Admin password (blank = generate)</label><input class="input" name="admin_password" type="text" autocomplete="off"></div>
      <button class="btn btn-primary">Create tenant</button>
    </div>
  </form>
</div>
