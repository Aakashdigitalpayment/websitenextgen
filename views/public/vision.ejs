<%- include('../partials/page-head', { crumbs: [['/about', t('हाम्रो बारेमा', 'About')]] }) %>
<section class="section"><div class="container">
  <% if (!blocks.length) { %><div class="empty"><%= t('सामग्री चाँडै राखिनेछ।', 'Content coming soon.') %></div><% } %>
  <div class="grid grid-3"><% blocks.forEach((b, i) => { %>
    <div class="card"><span class="icon-tile"><%- icon(['eye','star','heart'][i] || 'check') %></span><h3><%= b[0] %></h3><div class="prose muted"><%- util.richText(b[1]) %></div></div>
  <% }) %></div>
</div></section>
