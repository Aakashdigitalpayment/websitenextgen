<%- include('../partials/page-head', {}) %>
<% const CAT = { general: ['सामान्य', 'General'], forms: ['फारमहरू', 'Forms'], reports: ['प्रतिवेदन', 'Reports'], policies: ['नीति/नियम', 'Policies'], notices: ['सूचना', 'Notices'] };
   const catLabel = c => (CAT[String(c).toLowerCase()] ? t(...CAT[String(c).toLowerCase()]) : c);
   const kind = d => String(d.file_type || String(d.file_path || '').split('.').pop() || '').toLowerCase().replace(/^\./, ''); %>
<section class="section"><div class="container">
  <% if (cats.length) { %><div class="tabs"><a class="tab <%= !cat ? 'active' : '' %>" href="/downloads"><%= t('सबै', 'All') %></a><% cats.forEach(c => { %><a class="tab <%= cat === c ? 'active' : '' %>" href="?category=<%= encodeURIComponent(c) %>"><%= catLabel(c) %></a><% }) %></div><% } %>
  <% if (!items.length) { %><div class="empty"><%= t('फाइल छैन।', 'No files yet.') %></div><% } else { %>
  <div class="table-wrap"><table class="table"><thead><tr><th><%= t('शीर्षक', 'Title') %></th><th><%= t('प्रकार', 'Type') %></th><th></th></tr></thead><tbody>
    <% items.forEach(d => { %><tr><td><div class="flex gap-1 items-center"><span class="ft ft-<%= /pdf/.test(kind(d)) ? 'pdf' : /docx?|odt/.test(kind(d)) ? 'doc' : /xlsx?|csv|ods/.test(kind(d)) ? 'xls' : /jpe?g|png|webp|gif/.test(kind(d)) ? 'img' : 'any' %>"><%- icon(/jpe?g|png|webp|gif/.test(kind(d)) ? 'image' : 'file') %></span><span style="font-weight:500"><%= f(d, 'title') %></span></div><div class="small faint"><%= bsDate(d.created_at) %><% if (!cat && d.category) { %> · <%= catLabel(d.category) %><% } %><% if (Number(d.download_count)) { %> · <%= t(num(d.download_count) + ' पटक डाउनलोड', d.download_count + ' downloads') %><% } %></div></td><td><span class="badge"><%= (d.file_type || String(d.file_path || '').split('.').pop() || '').toUpperCase() %></span></td><td class="text-right"><a class="btn btn-soft btn-sm" href="/downloads/<%= d.id %>/file" target="_blank" rel="noopener"><%- icon('download') %><%= t('डाउनलोड', 'Download') %></a></td></tr><% }) %>
  </tbody></table></div><% } %>
</div></section>
