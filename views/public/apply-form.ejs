<%- include('../partials/page-head', { crumbs: [['/apply', t('अनलाइन सेवा', 'Online services')]], lead: mod.intro ? t(...mod.intro) : '' }) %>
<link rel="stylesheet" href="/static/css/forms.css">
<section class="section"><div class="container <%= mod.wide ? 'maxw-lg' : 'maxw-md' %>" style="margin-left:0">
  <% if (Object.keys(errors).length) { %><div class="alert alert-error"><%- icon('alert') %><span><%= errors._upload || t('कृपया रातो चिन्ह लागेका विवरण सच्याउनुहोस्।', 'Please correct the highlighted fields.') %></span></div><% } %>
  <% if (locals.activeProgram) { const p = activeProgram; %>
    <div class="card mb-3" style="border-color:var(--brand-line)"><div class="flex gap-2 items-center"><span class="icon-tile" style="margin:0"><%- icon('award') %></span>
      <div class="grow"><h3 class="mb-0"><%= f(p, 'title') %></h3><div class="small muted"><%= [p.event_label, p.fiscal_year ? t('आ.व. ', 'FY ') + p.fiscal_year : ''].filter(Boolean).join(' · ') %></div></div>
      <% if (p.closes_at) { %><span class="badge badge-warn"><%= t('बन्द हुने: ', 'Closes: ') %><%= bsDate(p.closes_at) %></span><% } %></div>
      <% const ins = lang === 'en' ? (p.instructions_en || p.instructions_np) : (p.instructions_np || p.instructions_en); if (ins) { %><div class="prose small mt-2"><%- util.richText(ins) %></div><% } %>
    </div>
  <% } %>
  <% if (locals.kymGateOk) { %>
    <div class="alert alert-success"><%- icon('check') %><span class="grow"><%= t('प्रमाणित भयो। तल खाली विवरण भर्नुहोस्; लक भएका विवरण जस्ताको त्यस्तै रहन्छन्।', 'Verified. Fill in the empty fields below; locked fields stay as they are.') %> (<code><%= lockedValues.member_id %></code>)</span>
      <form method="post" action="/apply/kyc/reset" class="inline"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm"><%= t('अर्को सदस्य', 'Another member') %></button></form></div>
  <% } %>
  <% if (locals.identity) { %>
    <div class="card identity-card mb-3">
      <div class="small muted mb-1"><%- icon('shield') %> <%= t('तपाईंको जानकारी (KYM / प्रोफाइलबाट)', 'Your details (from your KYM / profile)') %></div>
      <div class="kv">
        <div><%= t('नाम', 'Name') %></div><div><%= identity.name || '—' %></div>
        <div><%= t('सदस्यता नं.', 'Member ID') %></div><div><%= identity.member_id || '—' %></div>
        <div><%= t('मोबाइल', 'Mobile') %></div><div><%= identity.phone || '—' %></div>
        <div><%= t('इमेल', 'Email') %></div><div><%= identity.email || '—' %></div>
        <% if (identity.address) { %><div><%= t('ठेगाना', 'Address') %></div><div><%= identity.address %></div><% } %>
      </div>
      <div class="small faint mt-1"><%= t('यी विवरण परिवर्तन गर्न प्रोफाइल वा केवाइएम अद्यावधिक गर्नुहोस्।', 'To change these, update your profile or KYM.') %> <a href="/member/profile"><%= t('प्रोफाइल', 'Profile') %></a></div>
    </div>
    <% if (mod.memberGate.approved && kycStatus !== 'approved') { %><div class="alert alert-warn"><%- icon('alert') %><span><%= t('यो सेवाका लागि स्वीकृत केवाइएम चाहिन्छ।', 'This service needs an approved KYM.') %> <a href="/apply/kyc"><%= t('केवाइएम भर्नुहोस्', 'Fill in the KYM') %></a></span></div><% } %>
  <% } else if (member) { %><div class="alert alert-info"><%- icon('user') %><span><%= t('तपाईंको सदस्य विवरण पहिले नै भरिएको छ।', 'Your member details have been pre-filled.') %></span></div>
  <% } else if (mod.memberGate && mod.memberGate.always) { %><div class="alert alert-info"><%- icon('shield') %><span><%= t('सदस्यता नं. र दर्ता भएको मोबाइल मिलेपछि नाम, इमेल र ठेगाना तपाईंको स्वीकृत केवाइएमबाट लिइन्छ।', 'Once your Member ID and registered mobile match, your name, email and address are taken from your approved KYM.') %></span></div><% } %>
  <% if (mod.wide) { %><nav class="form-toc" aria-label="<%= t('खण्डहरू', 'Sections') %>"><% mod.sections.forEach((sec, i) => { if (!sec.title) return; %><a href="#sec_<%= i %>"><%= num(i + 1) %>. <%= t(...sec.title) %></a><% }) %></nav><% } %>
  <form class="form-card" method="post" action="/apply/<%= mod.key %><%= mod.fileFields.length ? "?_csrf=" + encodeURIComponent(csrfToken) : "" %>" enctype="<%= mod.fileFields.length ? 'multipart/form-data' : 'application/x-www-form-urlencoded' %>" novalidate data-app-form data-lang="<%= lang %>"<%- mod.wizard ? ' data-wizard' : '' %> data-draft-key="<%= locals.draftKey || '' %>" data-has-values="<%= locals.hasValues ? 1 : 0 %>">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="hp" name="website" tabindex="-1" autocomplete="off" aria-hidden="true">
    <% mod.sections.forEach((sec, i) => { %>
      <div class="form-section" id="sec_<%= i %>">
        <% if (sec.title) { %><div class="form-section-title"><%= t(...sec.title) %></div><% } %>
        <div class="form-grid"><% sec.fields.filter(fl => !(locals.skipFields && skipFields.has(fl.name))).forEach(fl => { %><%- include('../partials/field', { field: fl, values: Object.assign({}, values, query.type && fl.name === 'service_type' && !values.service_type ? { service_type: query.type } : {}), errors, options }) %><% }) %></div>
      </div>
    <% }) %>
    <%- include('../partials/turnstile') %>
    <div class="form-actions">
      <button class="btn btn-primary btn-lg"><%= t('आवेदन पेश गर्नुहोस्', 'Submit') %></button>
      <span class="small faint"><%= t('* चिन्ह भएका विवरण अनिवार्य छन्।', 'Fields marked * are required.') %></span>
    </div>
  </form>
</div></section>
<script src="/js/form-data.js" defer></script>
<script src="/static/js/forms.js" defer></script>
<% if (mod.capture) { %><script src="/static/js/kyc-capture.js" defer></script><% } %>
