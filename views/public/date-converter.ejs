<%- include('../partials/page-head', { lead: t('आज: ', 'Today: ') + nd.formatBs(today, lang) + ' (' + today + ' BS)' }) %>
<% const WD = lang === 'en' ? ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'] : nd.WEEKDAYS_NP; const MONTHS = lang === 'en' ? nd.MONTHS_EN : nd.MONTHS_NP; %>
<section class="section"><div class="container"><div class="grid grid-2">
  <form class="form-card" method="get">
    <h3><%= t('वि.सं. → ई.सं.', 'BS → AD') %></h3>
    <div class="flex gap-1 wrap">
      <div class="field"><label for="by"><%= t('साल', 'Year') %></label><select class="input" id="by" name="by"><% years.forEach(y => { %><option value="<%= y %>" <%= y === sel.y ? 'selected' : '' %>><%= num(y) %></option><% }) %></select></div>
      <div class="field"><label for="bm"><%= t('महिना', 'Month') %></label><select class="input" id="bm" name="bm"><% MONTHS.forEach((m, i) => { %><option value="<%= i + 1 %>" <%= i + 1 === sel.m ? 'selected' : '' %>><%= m %></option><% }) %></select></div>
      <div class="field"><label for="bd"><%= t('गते', 'Day') %></label><select class="input" id="bd" name="bd"><% for (let d = 1; d <= 32; d++) { %><option value="<%= d %>" <%= d === sel.d ? 'selected' : '' %>><%= num(d) %></option><% } %></select></div>
    </div>
    <p class="small faint mb-0"><%= t('वा टाइप गर्नुहोस् (नेपाली अंक पनि चल्छ):', 'Or type it (Nepali digits work):') %></p>
    <div class="field"><label class="sr-only" for="bs"><%= t('वि.सं. मिति', 'BS date') %></label><input class="input" id="bs" name="bs" placeholder="2081-05-15" value="<%= query.bs || '' %>"></div>
    <button class="btn btn-primary mt-2"><%= t('परिवर्तन', 'Convert') %></button>
    <% if (out.ad) { %><div class="alert <%= out.ad === 'invalid' ? 'alert-error' : 'alert-success' %> mt-2"><%= out.ad === 'invalid' ? t('मिति मिलेन', 'Invalid date') : out.ad + ' AD · ' + new Date(out.ad + 'T00:00:00Z').toUTCString().slice(5, 16) + ' · ' + WD[wdAd] %></div><% } %>
  </form>
  <form class="form-card" method="get">
    <h3><%= t('ई.सं. → वि.सं.', 'AD → BS') %></h3>
    <div class="field"><label for="ad"><%= t('ई.सं. मिति', 'AD date') %></label><input class="input" id="ad" name="ad" type="date" value="<%= query.ad || '' %>"></div>
    <button class="btn btn-primary mt-2"><%= t('परिवर्तन', 'Convert') %></button>
    <% if (out.bs) { %><div class="alert <%= out.bs === 'invalid' ? 'alert-error' : 'alert-success' %> mt-2"><%= out.bs === 'invalid' ? t('मिति मिलेन', 'Invalid date') : nd.formatBs(out.bs, lang) + ' (' + out.bs + ' BS)' + (wdBs !== null ? ' · ' + WD[wdBs] : '') %></div><% } %>
  </form>
</div></div></section>
