<section class="hero">
  <div class="container">
    <div class="hero-grid">
      <div>
        <div class="eyebrow"><%= settings.established_year ? t('स्थापना ' + num(settings.established_year), 'Since ' + settings.established_year) : t('सहकारी संस्था', 'Cooperative') %></div>
        <h1><%= (!sliders.length && settings.hero_title) || siteName %></h1>
        <p class="lead"><%= !sliders.length && settings.hero_subtitle ? settings.hero_subtitle : settings.about_short ? util.excerpt(settings.about_short, 220) : t('बचत, ऋण र डिजिटल सेवा — सदस्यको हितमा, समुदायको साथमा।', 'Savings, loans and digital services — for our members and community.') %></p>
        <div class="hero-actions" <%- locals.plan && !plan.has('applications') ? 'hidden' : '' %>>
          <a class="btn btn-primary btn-lg" href="/apply/account"><%= t('खाता खोल्नुहोस्', 'Open an account') %><%- icon('right') %></a>
          <a class="btn btn-outline btn-lg" href="/apply/loan"><%= t('ऋण आवेदन', 'Apply for a loan') %></a>
        </div>
      </div>
      <div class="hero-media <%= sliders.length ? "" : "is-empty" %>">
        <% if (sliders.length) { %>
          <div class="slider" data-slider>
            <% sliders.forEach((s, i) => { %>
              <div class="slide <%= i === 0 ? 'active' : '' %>">
                <picture><%- avifSource(s.image, '100vw') %><img src="<%= mediaUrl(s.image) %>"<%- srcset(s.image, '100vw') %> alt="<%= s.title || '' %>" <%= i ? 'loading=lazy' : 'fetchpriority=high' %> decoding="async"></picture>
                <% if (s.title || s.ctaText) { %><div class="slide-caption"><% if (s.title) { %><strong style="font-weight:500"><%= s.title %></strong><% } %><% if (s.subtitle) { %><div class="muted small"><%= s.subtitle %></div><% } %><% if (s.ctaText) { %><a class="btn btn-primary btn-sm mt-1" href="<%= s.ctaHref %>"<%- /^https?:/i.test(s.ctaHref) ? ' target="_blank" rel="noopener"' : '' %>><%= s.ctaText %><%- icon('right') %></a><% } %></div><% } %>
              </div>
            <% }) %>
            <% if (sliders.length > 1) { %><div class="slider-dots"><% sliders.forEach((s, i) => { %><button class="<%= i === 0 ? 'active' : '' %>" aria-label="Slide <%= i + 1 %>"></button><% }) %></div><% } %>
          </div>
        <% } else { %>
          <div style="height:100%;display:grid;place-items:center;color:var(--brand)"><%- icon('building', 'icon-lg') %></div>
        <% } %>
      </div>
    </div>

    <% const statList = [
      [profile?.total_members || stats.total_members || settings.total_members, t('सदस्य', 'Members')],
      [profile?.deposit ? money(profile.deposit) : stats.total_deposit, t('कुल बचत (रु.)', 'Deposits (Rs.)')],
      [profile?.loan ? money(profile.loan) : stats.total_loan, t('कुल ऋण (रु.)', 'Loans (Rs.)')],
      [settings.years_experience || (settings.established_year ? (Number(nd.todayBs().slice(0,4)) - Number(nd.toLatinDigits(settings.established_year))) : null), t('वर्षको अनुभव', 'Years of service')],
    ].filter(s => s[0]); %>
    <% if (statList.length) { %>
      <div class="stats">
        <% statList.forEach(s => { %><div class="stat"><div class="stat-value"><%= typeof s[0] === 'number' ? num(s[0].toLocaleString('en-IN')) : s[0] %></div><div class="stat-label"><%= s[1] %></div></div><% }) %>
      </div>
    <% } %>
    <div class="profile-bar">
      <% if (profile) { %><span class="small muted"><%= t('आ.व. ', 'FY ') + num(profile.fiscal_year) %><%= Number(profile.report_month) ? ' · ' + (lang === 'en' ? nd.MONTHS_EN : nd.MONTHS_NP)[profile.report_month - 1] : '' %></span><% } %>
      <a class="tab" href="/institutional-profile"><%- icon('chart') %> <%= t('संस्थागत प्रोफाइल', 'Institutional profile') %></a>
      <a class="tab" href="/reports?type=monthly"><%= t('मासिक प्रतिवेदन', 'Monthly reports') %><% if (hasMonthly) { %> <span class="badge badge-ok"><%= t('नयाँ', 'Latest') %></span><% } %></a>
      <a class="tab" href="/reports?type=annual"><%= t('वार्षिक प्रतिवेदन', 'Annual reports') %><% if (hasAnnual) { %> <span class="badge badge-ok"><%= t('नयाँ', 'Latest') %></span><% } %></a>
      <a class="tab" href="/reports"><%= t('सबै प्रतिवेदन', 'All reports') %></a>
      <% if (profile) { %><a class="small" href="/institutional-profile#charts"><%= t('चार्ट र पूरा विवरण हेर्नुहोस् →', 'View charts & full profile →') %></a><% } %>
    </div>
  </div>
</section>

<section class="section-sm">
  <div class="container">
    <div class="quick-links">
      <% [
        ['/apply/account', 'wallet', t('खाता खोल्नुहोस्', 'Open account')],
        ['/apply/loan', 'banknote', t('ऋण आवेदन', 'Loan')],
        ['/emi-calculator', 'calculator', t('EMI गणना', 'EMI calculator')],
        ['/interest-rates', 'percent', t('ब्याजदर', 'Interest rates')],
        ['/apply/appointment', 'calendar', t('भेटघाट', 'Appointment')],
        ['/track', 'search', t('आवेदन ट्र्याक', 'Track')],
        ['/apply/kyc', 'id', t('अनलाइन केवाइएम', 'Online KYM')],
        ['/apply/grievance', 'message', t('गुनासो', 'Grievance')],
        ['/apply/welfare', 'heart', t('कल्याण दाबी', 'Welfare claim')],
        ['/digital-services', 'phone', t('डिजिटल सेवा', 'Digital services')],
        ['/exchange-rate', 'globe', t('विनिमय दर', 'Exchange rates')],
        ['/date-converter', 'calendar', t('मिति परिवर्तन', 'Date converter')],
        ['/downloads', 'download', t('डाउनलोड', 'Downloads')],
        ['/auctions', 'gavel', t('लिलाम', 'Auctions')],
      ].filter(q => !locals.plan || plan.allows(q[0])).forEach(q => { %>
        <a class="quick-link" href="<%= q[0] %>"><span class="icon-tile"><%- icon(q[1]) %></span><%= q[2] %></a>
      <% }) %>
    </div>
  </div>
</section>

<% if (services.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head">
      <div><div class="eyebrow"><%= t('सेवाहरू', 'Services') %></div><h2><%= t('हाम्रा मुख्य सेवाहरू', 'What we offer') %></h2></div>
      <a class="btn btn-ghost" href="/services"><%= t('सबै सेवा', 'All services') %><%- icon('right') %></a>
    </div>
    <div class="grid grid-3">
      <% services.forEach(s => { %>
        <a class="card card-link" href="/services/<%= s.id %>">
          <span class="icon-tile"><%- icon(iconFor(s.icon, /loan|ऋण/i.test(s.title || '') ? 'banknote' : /digital|mobile/i.test(s.title || '') ? 'phone' : 'wallet')) %></span>
          <h3><%= f(s, 'title') %></h3>
          <p class="muted"><%= util.excerpt(f(s, 'description'), 120) %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section" style="padding-top:0">
  <div class="container">
    <div class="grid grid-2" style="gap:24px">
      <div class="card">
        <div class="section-head" style="margin-bottom:8px"><h3 class="mb-0"><%= t('पछिल्ला सूचना', 'Latest notices') %></h3><a class="small" href="/notices"><%= t('सबै', 'View all') %></a></div>
        <% if (!notices.length) { %><p class="muted"><%= t('हाल कुनै सूचना छैन।', 'No notices yet.') %></p><% } %>
        <ul class="list">
          <% notices.forEach(n => { const bs = nd.toBs(n.notice_date || n.created_at) || ''; const parts = bs.split('-'); %>
            <li class="list-item">
              <div class="date-chip"><b><%= num(Number(parts[2] || 0)) %></b><span><%= parts[1] ? (lang === 'en' ? nd.MONTHS_EN : nd.MONTHS_NP)[Number(parts[1]) - 1] : '' %></span></div>
              <div><a href="/notices/<%= n.id %>" style="color:var(--text);font-weight:500"><%= f(n, 'title') %></a>
                <% if (n.attachment) { %><div class="small faint"><%- icon('file') %></div><% } %></div>
            </li>
          <% }) %>
        </ul>
      </div>
      <div class="card">
        <div class="section-head" style="margin-bottom:8px"><h3 class="mb-0"><%= t('ब्याजदर', 'Interest rates') %></h3><a class="small" href="/interest-rates"><%= t('विस्तृत', 'Details') %></a></div>
        <% if (!rates.length) { %><p class="muted"><%= t('ब्याजदर चाँडै प्रकाशित हुनेछ।', 'Rates will be published soon.') %></p><% } %>
        <ul class="list">
          <% rates.forEach(r => { %>
            <li class="list-item" style="justify-content:space-between;align-items:center">
              <span><span class="badge <%= r.category === 'loan' ? 'badge-warn' : 'badge-ok' %>"><%= r.category === 'loan' ? t('ऋण', 'Loan') : t('बचत', 'Saving') %></span> &nbsp;<%= f(r, 'name') %></span>
              <strong style="font-weight:600"><%= num(Number(r.rate).toFixed(2)) %>%</strong>
            </li>
          <% }) %>
        </ul>
      </div>
    </div>
  </div>
</section>

<% if (features.length) { %>
<section class="section" style="background:var(--surface);border-top:1px solid var(--line);border-bottom:1px solid var(--line)">
  <div class="container">
    <div class="section-head"><div><div class="eyebrow"><%= t('किन हामी', 'Why us') %></div><h2><%= t('हामीलाई किन छान्ने?', 'Why choose us') %></h2></div></div>
    <div class="grid grid-3">
      <% features.forEach(fe => { %>
        <div>
          <span class="icon-tile"><%- icon(iconFor(fe.icon, 'check')) %></span>
          <h3><%= f(fe, 'title') %></h3>
          <p class="muted"><%= lang === 'en' ? (fe.desc_en || fe.desc_np) : (fe.desc_np || fe.desc_en) %></p>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (chairman || ceo || infoOfficer || grievanceOfficer) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head"><div><div class="eyebrow"><%= t('नेतृत्व', 'Leadership') %></div><h2><%= t('हाम्रो नेतृत्व र सम्पर्क अधिकारी', 'Our leadership & contact officers') %></h2></div><a class="btn btn-ghost" href="/team"><%= t('पूरा टिम', 'Full team') %><%- icon('right') %></a></div>
    <div class="grid grid-4">
      <% [chairman, ceo].filter(Boolean).forEach(l => { %>
        <div class="card person">
          <div class="person-photo"><% if (l.photo) { %><img src="<%= mediaUrl(l.photo) %>"<%- srcset(l.photo, '240px') %> alt="<%= l.name %>" loading="lazy"><% } else { %><%= (l.name || l.designation).charAt(0) %><% } %></div>
          <div class="person-name"><%= l.name || l.designation %></div>
          <div class="person-role"><%= l.designation %></div>
          <% if (l.message) { %><a class="btn btn-soft btn-sm mt-1" href="<%= l.href %>"><%= t('सन्देश पढ्नुहोस्', 'Read message') %></a><% } %>
        </div>
      <% }) %>
      <% [[infoOfficer, t('सूचना अधिकारी', 'Information officer'), '/team#contact-officers', t('थप विवरण', 'Details')], [grievanceOfficer, t('गुनासो सुन्ने अधिकारी', 'Grievance officer'), '/apply/grievance', t('गुनासो दर्ता', 'File a grievance')]].filter(o => o[0]).forEach(([p, role, href, cta]) => { %>
        <div class="card person">
          <div class="person-photo"><% if (p.photo) { %><img src="<%= mediaUrl(p.photo) %>"<%- srcset(p.photo, '240px') %> alt="<%= f(p, 'name') %>" loading="lazy"><% } else { %><%= (f(p, 'name') || '?').charAt(0) %><% } %></div>
          <div class="person-name"><%= f(p, 'name') %></div>
          <div class="person-role"><%= role %></div>
          <% if (p.phone) { %><div class="small mt-1"><a href="tel:<%= p.phone %>"><%= p.phone %></a></div><% } %>
          <% if (p.email) { %><div class="small"><a href="mailto:<%= p.email %>"><%= p.email %></a></div><% } %>
          <a class="btn btn-soft btn-sm mt-1" href="<%= href %>"><%= cta %></a>
        </div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (playStore || appStore) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="card app-promo">
      <div>
        <div class="eyebrow"><%= t('मोबाइल एप', 'Mobile app') %></div>
        <h2><%= t('आफ्नो डिजिटल भुक्तानी व्यवस्थापन गर्नुहोस्', 'Manage your digital payments') %></h2>
        <p class="muted"><%= t('ब्यालेन्स हेर्नुहोस्, रकम पठाउनुहोस्, बिल तिर्नुहोस् — जहाँ पनि, जुनसुकै बेला।', 'Check balances, send money and pay bills — anywhere, any time.') %></p>
        <div class="flex gap-1 wrap mt-2">
          <% if (playStore) { %><a class="btn btn-primary" href="<%= playStore %>" target="_blank" rel="noopener"><%- icon('phone') %>Google Play</a><% } %>
          <% if (appStore) { %><a class="btn btn-outline" href="<%= appStore %>" target="_blank" rel="noopener"><%- icon('phone') %>App Store</a><% } %>
        </div>
      </div>
      <% if (settings.mobile_app_photo) { %><img src="<%= mediaUrl(settings.mobile_app_photo) %>"<%- srcset(settings.mobile_app_photo, '320px') %> alt="<%= t('मोबाइल एप', 'Mobile app') %>" loading="lazy" decoding="async"><% } %>
    </div>
  </div>
</section>
<% } %>

<% if (appFeatures.length) { const featureCard = a => { %>
  <details class="card card-flat app-feature"><summary><span class="icon-tile"><%- icon(iconFor(a.icon, 'phone')) %></span><b style="font-weight:500"><%= f(a, 'title') %></b><% if (Number(a.is_new)) { %> <span class="badge badge-info"><%= t('नयाँ', 'New') %></span><% } %></summary>
    <% if (f(a, 'description')) { %><p class="muted small mt-1"><%= f(a, 'description') %></p><% } %></details>
<% }; %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head"><div><div class="eyebrow"><%= t('डिजिटल सेवा', 'Digital services') %></div><h2><%= t('एपका सुविधाहरू', 'App features') %></h2></div><a class="btn btn-ghost" href="/digital-services"><%= t('सबै सेवाहरू', 'All services') %><%- icon('right') %></a></div>
    <div class="grid grid-4"><% appFeatures.slice(0, 8).forEach(featureCard) %></div>
    <% if (appFeatures.length > 8) { %><details class="mt-2"><summary class="btn btn-ghost btn-sm"><%= t('थप हेर्नुहोस्', 'Show more') %> (<%= num(appFeatures.length - 8) %>)</summary><div class="grid grid-4 mt-2"><% appFeatures.slice(8).forEach(featureCard) %></div></details><% } %>
  </div>
</section>
<% } %>

<% if (awards.length) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head"><div><div class="eyebrow"><%= t('सम्मान', 'Recognition') %></div><h2><%= t('सम्मान तथा पुरस्कार', 'Awards & honours') %></h2></div><% if (awardCount > 3) { %><a class="btn btn-ghost" href="/awards"><%= t('सबै पुरस्कार', 'View all awards') %><%- icon('right') %></a><% } %></div>
    <div class="grid grid-3">
      <% awards.forEach(a => { %>
        <a class="card card-link" href="/awards/<%= a.id %>">
          <% if (a.image) { %><div class="card-media"><img src="<%= mediaUrl(a.image) %>"<%- srcset(a.image, '(max-width: 600px) 100vw, 380px') %> alt="" loading="lazy" decoding="async"></div><% } else { %><span class="icon-tile"><%- icon('award') %></span><% } %>
          <div class="card-meta"><%= [f(a, 'awarded_by'), a.award_date ? bsDate(a.award_date) : ''].filter(Boolean).join(' · ') %></div>
          <h3><%= f(a, 'title') %></h3>
          <% if (f(a, 'description')) { %><p class="muted small"><%= util.excerpt(f(a, 'description'), 110) %> <span class="faint"><%= t('थप पढ्नुहोस्', 'Read more') %></span></p><% } %>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (spotlight) { const sp = spotlight; %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="card spotlight">
      <div class="person-photo"><% if (sp.photo) { %><img src="<%= mediaUrl(sp.photo) %>"<%- srcset(sp.photo, '240px') %> alt="<%= lang === 'en' ? sp.member_name_en || sp.member_name : sp.member_name %>" loading="lazy"><% } else { %><%- icon('award', 'icon-lg') %><% } %></div>
      <div>
        <span class="badge badge-brand"><%= t('वर्षको सदस्य', 'Member of the year') %> <%= num(sp.spotlight_year) %></span>
        <h2 class="mt-1"><%= lang === 'en' ? sp.member_name_en || sp.member_name : sp.member_name %></h2>
        <div class="small muted"><%= [sp.member_id && t('सदस्य नं. ', 'Member no. ') + num(sp.member_id), sp.member_since && t('सदस्य बनेको ', 'Member since ') + num(sp.member_since)].filter(Boolean).join(' · ') %></div>
        <% const ach = lang === 'en' ? sp.achievement_en || sp.achievement : sp.achievement || sp.achievement_en; if (ach) { %><p class="mt-1"><%= ach %></p><% } %>
        <% const quote = lang === 'en' ? sp.quote_en || sp.quote : sp.quote || sp.quote_en; if (quote) { %><blockquote class="muted">“<%= quote %>”</blockquote><% } %>
        <a class="small" href="/awards"><%= t('सम्मान तथा पुरस्कार हेर्नुहोस् →', 'See awards & honours →') %></a>
      </div>
    </div>
  </div>
</section>
<% } %>

<% if (news.length) { %>
<section class="section">
  <div class="container">
    <div class="section-head"><div><div class="eyebrow"><%= t('समाचार', 'News') %></div><h2><%= t('पछिल्ला गतिविधि', 'Recent updates') %></h2></div><a class="btn btn-ghost" href="/news"><%= t('सबै समाचार', 'All news') %><%- icon('right') %></a></div>
    <div class="grid grid-3">
      <% news.forEach(n => { %>
        <a class="card card-link" href="/news/<%= n.id %>">
          <% if (n.image) { %><div class="card-media"><img src="<%= mediaUrl(n.image) %>"<%- srcset(n.image, '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px') %> alt="" loading="lazy" decoding="async"></div><% } else { %><span class="icon-tile"><%- icon('news') %></span><% } %>
          <div class="card-meta"><%= bsDate(n.created_at) %></div>
          <h3><%= f(n, 'title') %></h3>
          <p class="muted small"><%= util.excerpt(f(n, 'content'), 110) %></p>
        </a>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<% if (programs.length) { %>
<section class="section" style="padding-top:0">
  <div class="container">
    <div class="section-head"><h2><%= t('आगामी कार्यक्रम', 'Upcoming programmes') %></h2></div>
    <div class="grid grid-3">
      <% programs.forEach(p => { %>
        <div class="card"><div class="card-meta"><%- icon('calendar') %><%= bsDate(p.event_date) %><%= p.event_time ? ' · ' + p.event_time : '' %></div><h3><%= p.title %></h3><p class="muted small"><%= p.location || '' %></p></div>
      <% }) %>
    </div>
  </div>
</section>
<% } %>

<section class="section-sm">
  <div class="container">
    <div class="card" style="display:flex;gap:24px;align-items:center;justify-content:space-between;flex-wrap:wrap;background:var(--brand);color:var(--brand-ink);border:0">
      <div><h2 style="color:inherit;margin-bottom:4px"><%= t('सदस्य बन्नुहोस्', 'Become a member') %></h2><p style="margin:0;opacity:.85"><%= t('अनलाइन आवेदन दिनुहोस्, हामी तपाईंलाई सम्पर्क गर्नेछौं।', 'Apply online and we will get in touch.') %></p></div>
      <a class="btn btn-lg" style="background:var(--brand-ink);color:var(--brand)" href="/apply/membership" <%- locals.plan && !plan.has('applications') ? 'hidden' : '' %>><%= t('आवेदन दिनुहोस्', 'Apply now') %></a>
    </div>
  </div>
</section>
