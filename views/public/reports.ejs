<%- include('../partials/page-head', { crumbs: [['/about', t('हाम्रो बारेमा', 'About')]] }) %>
<section class="section"><div class="container">
  <% if (locked) { %><div class="alert alert-info"><%- icon('info') %><span><%= t(num(locked) + ' प्रतिवेदन सदस्यका लागि मात्र। ', num(locked) + ' reports are for members only. ') %><a href="/member/login?next=/reports"><%= t('लगइन गर्नुहोस्', 'Log in') %></a></span></div><% } %>
  <% if (!items.length) { %><div class="empty"><%= t('प्रतिवेदन छैन।', 'No reports yet.') %></div><% } else { %>
  <div class="grid grid-3"><% items.forEach(r => { %>
    <div class="card"><span class="icon-tile"><%- icon('chart') %></span><div class="card-meta"><%= [r.report_type, r.report_year && num(r.report_year), r.report_quarter].filter(Boolean).join(' · ') %></div><h3><%= f(r, 'title') %></h3>
      <% if (r.file_path) { %><a class="btn btn-soft btn-sm mt-1" href="<%= mediaUrl(r.file_path) %>" target="_blank" rel="noopener"><%- icon('download') %><%= t('हेर्नुहोस्', 'Open') %></a><% } %></div>
  <% }) %></div><% } %>
</div></section>
