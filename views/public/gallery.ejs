<%- include('../partials/page-head', {}) %>
<% const link = o => { const p = new URLSearchParams(); const v = { type: type === 'video' ? 'video' : '', album: album ? album.id : '', category, ...o }; Object.entries(v).forEach(([k, x]) => { if (x) p.set(k, x); }); const s = p.toString(); return '/gallery' + (s ? '?' + s : ''); }; %>
<section class="section"><div class="container">
  <nav class="tabs" aria-label="<%= t('मिडियाको प्रकार', 'Media type') %>">
    <a class="tab <%= type === 'photo' ? 'active' : '' %>" href="<%= link({ type: '', album: '', category: '' }) %>"><%- icon('image') %> <%= t('फोटो', 'Photos') %> (<%= num(counts.photo || 0) %>)</a>
    <a class="tab <%= type === 'video' ? 'active' : '' %>" href="<%= link({ type: 'video', album: '', category: '' }) %>"><%- icon('play') %> <%= t('भिडियो', 'Videos') %> (<%= num(counts.video || 0) %>)</a>
  </nav>

  <% if (showAlbums) { %>
    <div class="grid grid-3 album-grid">
      <% albums.forEach(a => { const cover = a.cover && /^https?:/i.test(a.cover) ? a.cover : a.cover ? mediaUrl(a.cover) : ''; %>
        <a class="card card-link album-card" href="<%= link({ album: a.id }) %>">
          <div class="card-media"><% if (cover) { %><img src="<%= cover %>" alt="" loading="lazy" decoding="async"><% } else { %><span class="icon-tile"><%- icon('image') %></span><% } %></div>
          <h3 class="mb-0"><%= f(a, 'name') %></h3><div class="small muted"><%= num(a.n) %> <%= type === 'video' ? t('भिडियो', 'videos') : t('फोटो', 'photos') %></div>
        </a>
      <% }) %>
    </div>
    <p class="mt-2"><a class="btn btn-ghost btn-sm" href="<%= link({}) + (link({}).includes('?') ? '&' : '?') %>view=all"><%= t('सबै एकैपटक हेर्नुहोस्', 'See everything') %> →</a></p>
  <% } else { %>
    <% if (album || category) { %><div class="flex gap-1 items-center mb-2"><a class="btn btn-ghost btn-sm" href="<%= link({ album: '', category: '' }) %>"><%- icon('left') %><%= t('सबै एल्बम', 'All albums') %></a><h2 class="mb-0"><%= album ? f(album, 'name') : category %></h2></div><% } %>
    <% if (!items.length) { %><div class="empty"><%= type === 'video' ? t('भिडियो छैन।', 'No videos yet.') : t('फोटो छैन।', 'No photos yet.') %></div><% } %>
    <div class="gallery" data-lightbox-group><% items.forEach(g => { %>
      <% if (type === 'video') { const ok = /^https:\/\//i.test(g.video_url || ''); if (ok) { %>
        <a class="video-tile" href="<%= g.video_url %>" target="_blank" rel="noopener" title="<%= f(g, 'title') %>"<% if (g.ytId) { %> data-video="<%= g.ytId %>"<% } %>><% if (g.thumb) { %><img src="<%= /^https?:/i.test(g.thumb) ? g.thumb : mediaUrl(g.thumb) %>" alt="<%= f(g, 'title') %>" loading="lazy"><% } else { %><span class="icon-tile"><%- icon('image') %></span><% } %><span class="play" aria-hidden="true"><%- icon('play') %></span><span class="sr-only"><%= t('भिडियो', 'Video') %>: <%= f(g, 'title') %></span></a>
      <% } } else if (g.image) { %>
        <a href="<%= mediaUrl(g.image) %>" target="_blank" rel="noopener" title="<%= f(g, 'title') %>" data-lightbox data-caption="<%= f(g, 'title') %>"><img src="<%= mediaUrl(g.image) %>"<%- srcset(g.image, '(max-width: 600px) 50vw, (max-width: 1000px) 33vw, 300px') %> alt="<%= f(g, 'title') %>" loading="lazy"></a>
      <% } %>
    <% }) %></div>
    <%- include('../partials/pagination', { pg }) %>
  <% } %>
</div></section>
<dialog class="lightbox" data-lightbox-dialog aria-label="<%= t('फोटो', 'Photo') %>">
  <button type="button" class="btn btn-ghost btn-icon lb-close" data-lb-close aria-label="<%= t('बन्द गर्नुहोस्', 'Close') %>"><%- icon('close') %></button>
  <button type="button" class="btn btn-ghost btn-icon lb-prev" data-lb-prev aria-label="<%= t('अघिल्लो', 'Previous') %>"><%- icon('left') %></button>
  <figure><div data-lb-body></div><figcaption class="small" data-lb-caption></figcaption></figure>
  <button type="button" class="btn btn-ghost btn-icon lb-next" data-lb-next aria-label="<%= t('अर्को', 'Next') %>"><%- icon('right') %></button>
</dialog>
