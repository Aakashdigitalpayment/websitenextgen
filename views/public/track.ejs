<%- include('../partials/page-head', { lead: t('ट्र्याकिङ नम्बर र आवेदनमा दिएको फोन नम्बर राख्नुहोस्, वा फोन + इमेलबाट आफ्ना सबै आवेदन हेर्नुहोस्।', 'Enter your tracking number and the phone number used on the application, or list all your applications by phone + email.') }) %>
<% const badgeFor = s => /approved|completed|resolved|selected|confirmed|disbursed/.test(s) ? 'badge-ok' : /rejected|cancelled/.test(s) ? 'badge-bad' : 'badge-warn'; %>
<section class="section"><div class="container maxw-md" style="margin-left:0">
  <div class="tabs">
    <a class="tab <%= mode !== 'contact' ? 'active' : '' %>" href="/track"><%= t('ट्र्याकिङ नम्बरबाट', 'By tracking number') %></a>
    <a class="tab <%= mode === 'contact' ? 'active' : '' %>" href="/track?mode=contact"><%= t('फोन + इमेलबाट सबै आवेदन', 'All my applications (phone + email)') %></a>
  </div>
  <% if (mode === 'contact' || query.mode === 'contact') { %>
  <form class="form-card" method="post" action="/track">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <div style="position:absolute;left:-5000px" aria-hidden="true"><input name="website" tabindex="-1" autocomplete="off"></div>
    <div class="form-grid">
      <div class="field"><label for="c_phone"><%= t('फोन नम्बर', 'Phone number') %></label><input class="input" id="c_phone" name="phone" type="tel" value="<%= phone %>" required></div>
      <div class="field"><label for="c_email"><%= t('इमेल', 'Email') %></label><input class="input" id="c_email" name="email" type="email" value="<%= email %>" required></div>
      <div class="field span-2"><label for="c_proof"><%= t('कुनै एक आवेदनको ट्र्याकिङ नम्बर (प्रमाणका लागि)', 'Tracking number of any one application (as proof)') %></label><input class="input" id="c_proof" name="proof" value="<%= proof %>" placeholder="LN-830718-7KQ2M" required><div class="field-hint"><%= t('फोन र इमेल मात्रले अरूको विवरण हेर्न नमिलोस् भनेर एउटा रसिदको नम्बर चाहिन्छ।', 'One receipt number is required so a phone and email alone cannot reveal someone’s records.') %></div></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary"><%- icon('search') %><%= t('खोज्नुहोस्', 'Search') %></button></div>
  </form>
  <% if (listError) { %><div class="alert alert-error mt-3"><%= listError %></div><% } %>
  <% if (cardLink) { %><div class="alert alert-info mt-3"><%- icon('id') %><span><%= t('तपाईं सदस्य हुनुहुन्छ: ', 'You are a member: ') %><strong><%= cardName %></strong> — <a href="<%= cardLink %>" rel="noopener"><%= t('डिजिटल परिचयपत्र हेर्नुहोस् (१५ मिनेट मान्य)', 'View your digital ID card (valid for 15 minutes)') %></a></span></div><% } %>
  <% if (list) { %>
    <% if (!list.length) { %><div class="empty mt-3"><%= t('कुनै आवेदन भेटिएन।', 'No applications found.') %></div><% } else { %>
    <p class="small muted mt-3"><%= t(list.length + ' आवेदन भेटियो।', list.length + ' application(s) found.') %></p>
    <div class="table-wrap"><table class="table"><thead><tr><th><%= t('सेवा', 'Service') %></th><th><%= t('ट्र्याकिङ नं.', 'Tracking no.') %></th><th><%= t('मिति', 'Submitted') %></th><th><%= t('स्थिति', 'Status') %></th></tr></thead><tbody>
      <% list.forEach(({ mod, row }) => { %><tr><td><%= t(...mod.title) %></td><td><a href="/track?id=<%= encodeURIComponent(row.tracking_id) %>&phone=<%= encodeURIComponent(phone) %>"><code><%= row.tracking_id %></code></a></td><td class="small"><%= bsDate(row.created_at) %></td><td><% if (!mod.noStatus) { %><span class="badge <%= badgeFor(row.status) %>"><%= statusLabel(row.status || 'pending') %></span><% } %></td></tr><% }) %>
    </tbody></table></div><% } %>
  <% } %>
  <% } else { %>
  <form class="form-card" method="get">
    <div class="form-grid">
      <div class="field"><label for="id"><%= t('ट्र्याकिङ नम्बर', 'Tracking number') %></label><input class="input" id="id" name="id" value="<%= id %>" placeholder="LN-830718-7KQ2M" required></div>
      <div class="field"><label for="phone"><%= t('फोन नम्बर', 'Phone number') %></label><input class="input" id="phone" name="phone" type="tel" value="<%= phone %>" required></div>
    </div>
    <div class="form-actions"><button class="btn btn-primary"><%- icon('search') %><%= t('खोज्नुहोस्', 'Search') %></button></div>
  </form>
  <% if (locals.blocked) { %><div class="alert alert-error mt-3"><%= t(`सुरक्षाका लागि यो खोज केही समय रोकिएको छ। ${blocked} मिनेटपछि प्रयास गर्नुहोस्।`, `For your security this search is paused. Try again in ${blocked} minute(s).`) %></div>
  <% } else if (searched && !result) { %><div class="alert alert-error mt-3"><%= t('विवरण भेटिएन। ट्र्याकिङ नम्बर र फोन जाँच गर्नुहोस्।', 'Not found. Check the tracking number and phone.') %></div><% } %>
  <% if (result) { const r = result.row, m = result.mod; %>
    <div class="card mt-3">
      <div class="flex justify-between items-center wrap gap-1"><div><div class="small muted"><%= t(...m.title) %></div><h3 class="mb-0"><%= r.tracking_id %></h3></div>
        <span class="badge <%= badgeFor(r.status) %>" style="font-size:.9rem"><%= statusLabel(r.status || 'pending') %></span></div>
      <div class="kv mt-2">
        <div><%= t('नाम', 'Name') %></div><div><%= r[m.nameCol] %></div>
        <div><%= t('पेश मिति', 'Submitted') %></div><div><%= bsDate(r.created_at) %></div>
        <% if (r[m.remarksCol]) { %><div><%= t('कार्यालयको टिप्पणी', 'Office remarks') %></div><div><%= r[m.remarksCol] %></div><% } %>
        <% if (m.attachCol && r[m.attachCol]) { %><div><%= t('कार्यालयको संलग्न फाइल', 'Office attachment') %></div><div><a class="btn btn-soft btn-sm" href="/track/attachment?id=<%= encodeURIComponent(r.tracking_id) %>&phone=<%= encodeURIComponent(phone) %>" rel="nofollow"><%- icon('download') %><%= t('डाउनलोड', 'Download') %></a></div><% } %>
      </div>
      <% if (history.length) { %><h4 class="mt-3"><%= t('प्रगति', 'Progress') %></h4><ul class="timeline mt-1"><% history.forEach(h => { %><li><div class="small faint"><%= bsDate(h.created_at) %></div><div style="font-weight:500"><%= statusLabel(h.new_status) %></div><% if (h.admin_comment) { %><div class="small muted"><%= h.admin_comment %></div><% } %></li><% }) %></ul><% } %>
    </div>
  <% } %>
  <% } %>
</div></section>
