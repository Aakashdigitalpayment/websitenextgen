<%- include('../partials/page-head', { lead: t('बचत, ऋण र डिजिटल सेवाहरू — तपाईंको आवश्यकता अनुसार।', 'Savings, loans and digital services for every need.') }) %>
<section class="section"><div class="container">
  <% if (!services.length) { %><div class="empty"><%= t('सेवाहरू चाँडै थपिनेछन्।', 'Services will be listed soon.') %></div><% } %>
  <% const groups = cats.length ? cats.map(c => ({ c, items: services.filter(s => s.service_category_id === c.id) })).concat([{ c: null, items: services.filter(s => !cats.some(c => c.id === s.service_category_id)) }]) : [{ c: null, items: services }]; %>
  <% groups.filter(g => g.items.length).forEach(g => { %>
    <% if (g.c) { %><h2 class="mt-3"><%= f(g.c, 'name') %></h2><% } %>
    <div class="grid grid-3 mt-2"><% g.items.forEach(s => { %>
      <a class="card card-link" href="/services/<%= s.id %>">
        <% if (s.image) { %><div class="card-media"><img src="<%= mediaUrl(s.image) %>"<%- srcset(s.image, '(max-width: 600px) 100vw, (max-width: 1000px) 50vw, 380px') %> alt="" loading="lazy"></div><% } else { %><span class="icon-tile"><%- icon('wallet') %></span><% } %>
        <h3><%= f(s, 'title') %></h3><p class="muted small"><%= util.excerpt(f(s, 'description'), 140) %></p>
      </a>
    <% }) %></div>
  <% }) %>
</div></section>
