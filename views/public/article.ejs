<%- include('../partials/page-head', { crumbs: [[base, crumb]], lead: date ? bsDate(date) : '' }) %>
<section class="section"><div class="container layout-side">
  <article>
    <% if (image) { %><img src="<%= mediaUrl(image) %>" alt="" style="border-radius:var(--radius);margin-bottom:24px;width:100%"><% } %>
    <div class="prose"><%- util.richText(locals.content) %></div>
    <% if (locals.attachment) { %><a class="btn btn-outline mt-2" href="<%= mediaUrl(attachment) %>" target="_blank" rel="noopener"><%- icon('download') %><%= t('संलग्न फाइल', 'Attachment') %></a><% } %>
  </article>
  <aside class="card">
    <h3><%= t('अन्य', 'More') %></h3>
    <ul class="list"><% more.forEach(m => { %><li class="list-item" style="flex-direction:column;gap:2px"><a href="<%= base %>/<%= m.id %>" style="color:var(--text)"><%= f(m, 'title') %></a><span class="small faint"><%= bsDate(m.created_at) %></span></li><% }) %></ul>
  </aside>
</div></section>
