<!doctype html>
<html lang="<%= lang === 'en' ? 'en' : 'ne' %>"<% if (locals.theme && theme.attr) { %> data-theme="<%= theme.attr %>"<% } %>>
<head>
  <meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= locals.title ? title + ' · ' : '' %>Admin · <%= siteName %></title>
  <meta name="robots" content="noindex">
  <link rel="preconnect" href="https://fonts.googleapis.com"><link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
  <link rel="preload" href="/static/fonts/noto-deva-300.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/static/css/app.css"><link rel="stylesheet" href="/static/css/admin.css">
  <style>:root{--brand:<%= locals.theme ? theme.brand : brandColor %>}</style>
</head>
<body class="panel">
<div class="shell">
  <aside class="sidebar" data-nav>
    <a class="brand" href="/admin">
      <% if (settings.logo) { %><img src="<%= mediaUrl(settings.logo) %>" alt=""><% } else { %><span class="brand-mark"><%= (siteName || 'A').trim().charAt(0) %></span><% } %>
      <span class="brand-name" style="font-size:.92rem"><%= siteName %></span>
    </a>
    <% const lvl = roleLevel(admin.role); const cur = path.replace(/\/$/, '') || '/'; %>
    <a class="side-link <%= cur === '/admin' ? 'active' : '' %>" href="/admin"><%- icon('home') %><%= t('ड्यासबोर्ड', 'Dashboard') %></a>
        <% if (lvl >= 2) { %>
    <div class="side-group"><div class="side-title"><%= t('आवेदन तथा अनुरोध', 'Applications') %></div>
      <% Object.values(modules).forEach(m => { %>
        <a class="side-link <%= cur.startsWith('/admin/inbox/' + m.key) ? 'active' : '' %>" href="/admin/inbox/<%= m.key %>"><%- icon(m.icon) %><%= t(...m.title) %><% if (locals.pendingCounts && pendingCounts[m.key]) { %><span class="count"><%= num(pendingCounts[m.key]) %></span><% } %></a>
      <% }) %>
    </div>
    <div class="side-group"><div class="side-title"><%= t('सदस्य', 'Members') %></div>
      <a class="side-link <%= cur.startsWith('/admin/members') ? 'active' : '' %>" href="/admin/members"><%- icon('users') %><%= t('सदस्यहरू', 'Members') %></a>
      <a class="side-link <%= cur.startsWith('/admin/programs') ? 'active' : '' %>" href="/admin/programs"><%- icon('qr') %><%= t('कार्यक्रम उपस्थिति', 'Programme attendance') %></a>
      <a class="side-link <%= cur.startsWith('/admin/elections') ? 'active' : '' %>" href="/admin/elections"><%- icon('vote') %><%= t('निर्वाचन नतिजा', 'Election results') %></a>
      <a class="side-link <%= cur.startsWith('/admin/partners') ? 'active' : '' %>" href="/admin/partners"><%- icon('store') %><%= t('साझेदार डेस्क', 'Partner desks') %></a>
      <a class="side-link <%= cur.startsWith('/admin/institutional-welfare') ? 'active' : '' %>" href="/admin/institutional-welfare"><%- icon('heart') %><%= t('संस्थागत राहत', 'Institutional welfare') %></a>
      <a class="side-link <%= cur.startsWith('/admin/marketplace') ? 'active' : '' %>" href="/admin/marketplace"><%- icon('store') %><%= t('सदस्य बजार', 'Marketplace') %></a>
      <a class="side-link <%= cur.startsWith('/admin/password-requests') ? 'active' : '' %>" href="/admin/password-requests"><%- icon('shield') %><%= t('पासवर्ड अनुरोध', 'Password requests') %></a>
    </div>
    <% } %>
    <% Object.entries(GROUPS).forEach(([g, label]) => { const list = Object.values(resources).filter(r => r.group === g && (!r.minRole || lvl >= roleLevel(r.minRole))); if (!list.length) return; %>
      <div class="side-group"><div class="side-title"><%= t(...label) %></div>
        <% list.forEach(r => { %>
          <a class="side-link <%= cur.startsWith('/admin/r/' + r.key + '/') || cur === '/admin/r/' + r.key ? 'active' : '' %>" href="/admin/r/<%= r.key %>"><%- icon(r.icon) %><%= t(...r.title) %></a>
        <% }) %>
      </div>
    <% }) %>
    <div class="side-group"><div class="side-title"><%= t('प्रणाली', 'System') %></div>
      <% if (lvl >= 3) { %><a class="side-link <%= cur.startsWith('/admin/settings') ? 'active' : '' %>" href="/admin/settings"><%- icon('settings') %><%= t('सेटिङ', 'Settings') %></a>
      <a class="side-link <%= cur.startsWith('/admin/theme') ? 'active' : '' %>" href="/admin/theme"><%- icon('sun') %><%= t('रूप / थिम', 'Theme') %></a>
      <a class="side-link <%= cur.startsWith('/admin/notifications') ? 'active' : '' %>" href="/admin/notifications"><%- icon('bell') %><%= t('SMS/इमेल/Push', 'SMS / email / push') %></a>
      <a class="side-link <%= cur.startsWith('/admin/license') ? 'active' : '' %>" href="/admin/license"><%- icon('award') %><%= t('सेवा नवीकरण', 'Licence') %></a>
      <a class="side-link <%= cur.startsWith('/admin/audit') ? 'active' : '' %>" href="/admin/audit"><%- icon('eye') %><%= t('अडिट लग', 'Audit log') %></a><% } %>
      <% if (lvl >= 4) { %><a class="side-link <%= cur.startsWith('/admin/users') ? 'active' : '' %>" href="/admin/users"><%- icon('shield') %><%= t('प्रशासक', 'Admin users') %></a>
      <a class="side-link <%= cur.startsWith('/admin/domains') ? 'active' : '' %>" href="/admin/domains"><%- icon('globe') %><%= t('वेबसाइट डोमेन', 'Website domain') %></a>
      <a class="side-link <%= cur.startsWith('/admin/integrations') ? 'active' : '' %>" href="/admin/integrations"><%- icon('link') %><%= t('CBS/DMS API', 'CBS / DMS API') %></a>
      <a class="side-link <%= cur.startsWith('/admin/credentials') ? 'active' : '' %>" href="/admin/credentials"><%- icon('settings') %><%= t('कार्यालय पासवर्ड', 'Office credentials') %></a>
      <a class="side-link <%= cur.startsWith('/admin/system') || cur.startsWith('/admin/backup') ? 'active' : '' %>" href="/admin/system"><%- icon('chart') %><%= t('प्रणाली / ब्याकअप', 'System / backup') %></a><% } %>
      <a class="side-link <%= cur.startsWith('/admin/2fa') ? 'active' : '' %>" href="/admin/2fa"><%- icon('shield') %><%= t('दुई-चरण प्रमाणीकरण', '2-step login') %></a>
      <a class="side-link <%= cur.startsWith('/admin/password') && !cur.startsWith('/admin/password-') ? 'active' : '' %>" href="/admin/password"><%- icon('settings') %><%= t('पासवर्ड', 'Password') %></a>
    </div>
  </aside>
  <div class="main">
    <header class="topnav">
      <button class="btn btn-ghost btn-icon side-toggle" data-nav-toggle aria-label="Menu"><%- icon('menu') %></button>
      <a class="btn btn-ghost btn-sm" href="/" target="_blank" rel="noopener"><%- icon('globe') %><span class="btn-text"><%= t('वेबसाइट', 'View site') %></span></a>
      <div class="grow"></div>
      <%- include('../partials/theme-picker') %>
      <span class="lang-switch"><a href="/lang/np?next=<%= encodeURIComponent(path) %>" class="<%= lang === 'np' ? 'active' : '' %>">ने</a><a href="/lang/en?next=<%= encodeURIComponent(path) %>" class="<%= lang === 'en' ? 'active' : '' %>">EN</a></span>
      <div class="who"><b><%= admin.full_name || admin.username %></b><%= admin.role %></div>
      <form method="post" action="/admin/logout"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-icon" aria-label="Log out" title="Log out"><%- icon('logout') %></button></form>
    </header>
    <main class="content">
      <% (locals.flash || []).forEach(m => { %><div class="alert alert-<%= m.type %>"><%= m.message %></div><% }) %>
      <% if (locals.license && license.configured && license.daysLeft <= 30) { %><div class="alert <%= license.expired ? 'alert-error' : 'alert-warn' %>"><%- icon('alert') %><span><%= license.expired ? t('वेबसाइट सेवाको म्याद सकियो — सार्वजनिक साइट बन्द छ।', 'Website licence expired — the public site is offline.') : t('वेबसाइट सेवाको म्याद ' + num(license.daysLeft) + ' दिनमा सकिँदैछ।', 'Website licence expires in ' + license.daysLeft + ' days.') %> <% if (roleLevel(admin.role) >= 3) { %><a href="/admin/license"><%= t('नवीकरण', 'Renew') %></a><% } %></span></div><% } %>
      <% if (admin.must_change_password && path !== '/admin/password') { %><div class="alert alert-warn"><%- icon('alert') %><span><%= t('सुरक्षाका लागि पासवर्ड परिवर्तन गर्नुहोस्।', 'Please change your password.') %> <a href="/admin/password"><%= t('अहिले परिवर्तन गर्नुहोस्', 'Change now') %></a></span></div><% } %>
      <%- body %>
    </main>
  </div>
</div>
<script src="/static/js/app.js" defer></script>
</body>
</html>
