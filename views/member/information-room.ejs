<div class="content-head"><h1><%= title %></h1></div>
<div class="alert alert-info"><%- icon('shield') %><span><%= t('यहाँका कागजात गोप्य हुन्। हेरेको विवरण अभिलेख गरिन्छ।', 'These documents are confidential. Access is logged.') %></span></div>
<% if (!items.length) { %><div class="empty"><%= t('कागजात छैन।', 'No documents yet.') %></div><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th><%= t('शीर्षक', 'Title') %></th><th><%= t('समूह', 'Category') %></th><th><%= t('मिति', 'Date') %></th><th></th></tr></thead><tbody>
  <% items.forEach(i => { %><tr><td><div style="font-weight:500"><%= f(i, 'title') %></div><% if (i.reference_no) { %><div class="small faint"><%= i.reference_no %></div><% } %></td><td><% const cl = (locals.categories || {})[i.category]; %><% if (i.category) { %><span class="badge"><%= cl ? t(...cl) : i.category %></span><% } %></td><td class="small"><%= i.meeting_date ? bsDate(i.meeting_date) : '' %></td>
    <td class="text-right"><a class="btn btn-soft btn-sm" href="/member/information-room/<%= i.id %>/view"><%- icon('eye') %><%= t('हेर्नुहोस्', 'View') %></a><% if (i.allow_download) { %> <a class="btn btn-ghost btn-sm" href="/member/information-room/<%= i.id %>"><%- icon('download') %><%= t('डाउनलोड', 'Download') %></a><% } %></td></tr><% }) %>
</tbody></table></div><% } %>
