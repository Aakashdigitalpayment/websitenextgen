<% const badge = s => /approved|completed|resolved|selected|confirmed|disbursed|accepted|paid/.test(s) ? 'badge-ok' : /rejected|cancelled/.test(s) ? 'badge-bad' : 'badge-warn'; %>
<div class="content-head"><div><div class="small muted"><a href="/member/requests"><%= t('मेरा आवेदन', 'My applications') %></a> /</div><h1><%= title %></h1></div>
  <% if (!mod.noStatus) { %><span class="badge <%= badge(row.status || 'pending') %>" style="font-size:.9rem"><%= statusLabel(row.status || 'pending') %></span><% } %></div>
<div class="grid" style="grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:20px">
  <div class="card">
    <div class="flex justify-between wrap gap-1"><div><div class="small muted"><%= t('ट्र्याकिङ नं.', 'Tracking no.') %></div><div style="font-weight:600"><code><%= row.tracking_id || '#' + row.id %></code></div></div>
      <div class="text-right"><div class="small muted"><%= t('पेश मिति', 'Submitted') %></div><div><%= bsDate(row.created_at) %></div></div></div>
    <%- include('../partials/request-progress', { steps, details: [] }) %>
    <% mod.sections.forEach(sec => {
         const rows = sec.fields.filter(fl => !['image', 'file', 'heading', 'family', 'moneyitems', 'checkbox'].includes(fl.type) && fl.store !== 'none')
           .map(fl => { let v = display.value(fl); if (v === null || v === undefined || v === '') return null; const lb = label(fl, v);
             if (lb) v = lb; else if (fl.format === 'money') v = 'रु. ' + money(v); else if (fl.type === 'date') v = bsDate(v); return [t(fl.label[0], fl.label[1]), v]; })
           .filter(Boolean);
         if (!rows.length) return; %>
      <% if (sec.title) { %><h4 class="mt-3 mb-1"><%= t(...sec.title) %></h4><% } %>
      <div class="kv"><% rows.forEach(([k, v]) => { %><div><%= k %></div><div><%= v %></div><% }) %></div>
    <% }) %>
    <% const myFiles = mod.fileFields.flatMap(fl => String(row[fl.name] || '').split(',').map(x => x.trim()).filter(Boolean).map((x, i) => [fl, i])); %>
    <% if (myFiles.length) { %><h4 class="mt-3 mb-1"><%= t('मेरा कागजात', 'My documents') %></h4>
      <div class="flex gap-1 wrap"><% myFiles.forEach(([fl, i]) => { %><a class="btn btn-outline btn-sm" href="/member/requests/<%= mod.key %>/<%= row.id %>/file/<%= fl.name %><%= i ? '?i=' + i : '' %>" target="_blank" rel="noopener"><%- icon('file') %><%= fl.label ? t(fl.label[0], fl.label[1]) : fl.name %><%= i ? ' ' + (i + 1) : '' %></a><% }) %></div>
    <% } %>
    <% (mod.trackCols || []).forEach(([col, lb, fmt]) => { const v = row[col]; if (v === null || v === undefined || v === '' || (fmt === 'money' && !Number(v))) return; %>
      <div class="kv mt-1"><div><%= t(...lb) %></div><div><strong><%= fmt === 'money' ? 'रु. ' + money(v) : fmt === 'date' ? bsDate(v) : v %></strong></div></div>
    <% }) %>
    <% if (mod.key === 'membership' && row.assigned_sadasyata) { %><div class="alert alert-success mt-2"><%- icon('check') %><span class="grow"><%= t('दिइएको सदस्यता नं.', 'Assigned Member ID') %>: <code><%= row.assigned_sadasyata %></code></span><a class="btn btn-primary btn-sm" href="/apply/kyc"><%= t('केवाइएम भर्नुहोस्', 'Fill in the KYM') %></a></div><% } %>
  </div>
  <div>
    <div class="card"><h3><%= t('कार्यालयको जवाफ', 'Office reply') %></h3>
      <% if (row[mod.remarksCol]) { %><p><%= row[mod.remarksCol] %></p><% } else { %><p class="muted small"><%= t('अहिलेसम्म जवाफ छैन।', 'No reply yet.') %></p><% } %>
      <% if (mod.attachCol && row[mod.attachCol]) { %><a class="btn btn-soft btn-sm" href="/member/requests/<%= mod.key %>/<%= row.id %>/attachment"><%- icon('download') %><%= t('कार्यालयको फाइल', 'Office file') %></a><% } %>
    </div>
    <div class="card mt-3"><h3><%= t('स्थिति इतिहास', 'Status history') %></h3>
      <% if (!history.length) { %><p class="muted small"><%= t('परिवर्तन भएको छैन।', 'No changes yet.') %></p><% } %>
      <ul class="timeline mt-1"><% history.forEach(h => { %><li><div class="small faint"><%= bsDate(h.created_at) %></div><div style="font-weight:500"><%= h.old_status ? statusLabel(h.old_status) + ' → ' : '' %><%= statusLabel(h.new_status) %></div><% if (h.admin_comment) { %><div class="small muted"><%= h.admin_comment %></div><% } %></li><% }) %></ul>
    </div>
  </div>
</div>
