<form class="form-card" method="post" action="/member/login<%= query.next ? '?next=' + encodeURIComponent(query.next) : '' %>">
  <h1 style="font-size:1.35rem"><%= t('सदस्य लगइन', 'Member sign in') %></h1>
  <p class="muted small"><%= t('मोबाइल नम्बर, सदस्यता नम्बर वा इमेल प्रयोग गर्नुहोस्।', 'Use your mobile number, membership number or email.') %></p>
  <% if (error) { %><div class="alert alert-error"><%= error %></div><% } %>
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="stack">
    <div class="field"><label for="i"><%= t('मोबाइल / सदस्यता नं. / इमेल', 'Mobile / member no. / email') %></label><input class="input" id="i" name="identifier" value="<%= identifier %>" autocomplete="username" required autofocus></div>
    <div class="field"><label for="p"><%= t('पासवर्ड', 'Password') %></label><input class="input" id="p" name="password" type="password" autocomplete="current-password" required></div>
    <button class="btn btn-primary btn-block btn-lg"><%= t('लगइन', 'Sign in') %></button>
    <% if (locals.googleEnabled) { %><a class="btn btn-outline btn-block" href="/member/oauth/google"><svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path fill="#4285F4" d="M21.6 12.2c0-.7-.1-1.4-.2-2H12v3.8h5.4a4.6 4.6 0 0 1-2 3v2.5h3.2c1.9-1.7 3-4.3 3-7.3z"/><path fill="#34A853" d="M12 22c2.7 0 5-.9 6.6-2.4l-3.2-2.5c-.9.6-2 1-3.4 1-2.6 0-4.8-1.8-5.6-4.1H3.1v2.6A10 10 0 0 0 12 22z"/><path fill="#FBBC05" d="M6.4 14c-.2-.6-.3-1.3-.3-2s.1-1.4.3-2V7.4H3.1A10 10 0 0 0 2 12c0 1.6.4 3.1 1.1 4.6L6.4 14z"/><path fill="#EA4335" d="M12 5.9c1.5 0 2.8.5 3.8 1.5l2.9-2.9A10 10 0 0 0 3.1 7.4L6.4 10c.8-2.3 3-4.1 5.6-4.1z"/></svg><%= t('Google बाट लगइन', 'Sign in with Google') %></a><% } %>
  </div>
  <div class="flex justify-between small mt-2"><a href="/member/forgot"><%= t('पासवर्ड बिर्सनुभयो?', 'Forgot password?') %></a><a href="/apply/membership"><%= t('सदस्य बन्नुहोस्', 'Become a member') %></a></div>
</form>
<p class="text-center small mt-2"><a href="/"><%= t('← वेबसाइटमा फर्कनुहोस्', '← Back to website') %></a></p>
