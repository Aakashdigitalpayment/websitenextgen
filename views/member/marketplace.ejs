<div class="content-head"><h1><%= title %></h1><div class="flex gap-1"><a class="btn btn-outline" href="/marketplace" target="_blank" rel="noopener"><%- icon('globe') %><%= t('बजार हेर्नुहोस्', 'View marketplace') %></a><a class="btn btn-primary" href="/member/marketplace/new"><%- icon('plus') %><%= t('नयाँ सूची', 'New listing') %></a></div></div>
<% if (!rows.length) { %><div class="empty"><%= t('तपाईंको उत्पादन वा सीप बिक्री/सेवाका लागि राख्नुहोस्।', 'List a product you sell or a skill you offer.') %><div class="mt-2 flex gap-1" style="justify-content:center"><a class="btn btn-soft" href="/member/marketplace/new?type=product"><%= t('उत्पादन', 'Product') %></a><a class="btn btn-soft" href="/member/marketplace/new?type=skill"><%= t('सीप/सेवा', 'Skill') %></a></div></div><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th><%= t('सूची', 'Listing') %></th><th><%= t('प्रकार', 'Type') %></th><th><%= t('स्थिति', 'Status') %></th><th></th></tr></thead><tbody>
  <% rows.forEach(l => { %><tr><td><div class="flex gap-1 items-center"><% if (l.image) { %><img class="thumb" src="<%= mediaUrl(l.image) %>" alt=""><% } %><div><div style="font-weight:500"><%= l.title %></div><div class="small faint"><%= catLabel(l.category) %><%= l.price ? ' · रु. ' + money(l.price) : '' %></div></div></div></td>
    <td><span class="badge"><%= l.listing_type === 'skill' ? t('सीप', 'Skill') : t('उत्पादन', 'Product') %></span></td>
    <td><span class="badge <%= l.status === 'approved' ? 'badge-ok' : l.status === 'pending' ? 'badge-warn' : l.status === 'rejected' ? 'badge-bad' : '' %>"><%= statusLabel(l.status) %></span><% if (l.admin_note) { %><div class="small faint"><%= l.admin_note %></div><% } %></td>
    <td><div class="row-actions"><a class="btn btn-ghost btn-sm btn-icon" href="/member/marketplace/<%= l.id %>/edit"><%- icon('edit') %></a><% if (l.status !== 'withdrawn') { %><form method="post" action="/member/marketplace/<%= l.id %>/withdraw"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm" data-confirm="<%= t('सूची हटाउने?', 'Withdraw listing?') %>"><%= t('हटाउने', 'Withdraw') %></button></form><% } %></div></td></tr><% }) %>
</tbody></table></div><% } %>
<h2 class="mt-4"><%= t('सोधपुछ', 'Inquiries') %></h2>
<% if (!inquiries.length) { %><p class="muted"><%= t('अहिलेसम्म सोधपुछ छैन।', 'No inquiries yet.') %></p><% } else { %>
<div class="card" style="padding:4px 22px"><ul class="list"><% inquiries.forEach(i => { %><li class="list-item"><div class="grow"><div style="font-weight:<%= i.is_read ? 400 : 500 %>"><%= i.inquirer_name %> · <a href="tel:<%= i.inquirer_phone %>"><%= i.inquirer_phone %></a></div><div class="small muted"><%= i.title %><%= i.message ? ' — ' + i.message : '' %></div></div><span class="small faint"><%= bsDate(i.created_at) %></span></li><% }) %></ul></div><% } %>
