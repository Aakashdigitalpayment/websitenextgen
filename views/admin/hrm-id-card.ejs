<!doctype html><html lang="ne"><head><meta charset="utf-8"><title><%= e.full_name %> — ID</title>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Noto+Sans+Devanagari:wght@400;500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="/static/css/app.css"><style>:root{--brand:<%= brandColor %>} body{background:#fff} .idc{width:54mm;height:86mm;border:1px solid #ddd;border-radius:4mm;overflow:hidden;display:flex;flex-direction:column;font-size:8.5pt;margin:10mm auto;color:#1c1f23}
.idc-h{background:var(--brand);color:#fff;padding:3mm;text-align:center;font-weight:600;font-size:9pt;line-height:1.25}.idc-b{flex:1;padding:3mm;text-align:center}.idc img.ph{width:24mm;height:28mm;object-fit:cover;border-radius:2mm;border:1px solid #eee;margin:0 auto 2mm}.idc .qr{width:17mm;height:17mm;margin:1mm auto 0}
@media print{.no-print{display:none}.idc{margin:0}}</style></head>
<body>
<div class="idc">
  <div class="idc-h"><%= siteName %><div style="font-weight:400;font-size:7pt;opacity:.85"><%= t('कर्मचारी परिचयपत्र', 'Staff ID card') %></div></div>
  <div class="idc-b">
    <% if (e.photo) { %><img class="ph" src="<%= mediaUrl(e.photo) %>" alt=""><% } else { %><div class="ph" style="width:24mm;height:28mm;margin:0 auto 2mm;background:#f4f4f3;border-radius:2mm"></div><% } %>
    <div style="font-weight:600;font-size:10pt"><%= e.full_name %></div>
    <% if (e.full_name_en) { %><div style="font-size:7.5pt;color:#5f6670"><%= e.full_name_en %></div><% } %>
    <div style="margin-top:1mm"><%= e.designation || '' %></div>
    <div style="font-size:7.5pt;color:#5f6670"><%= e.department_np || '' %></div>
    <div style="margin-top:1mm;font-family:ui-monospace,monospace;font-size:8pt"><%= e.employee_code %></div>
    <img class="qr" src="<%= qr %>" alt="QR">
  </div>
</div>
<p class="text-center no-print"><button class="btn btn-primary" data-print type="button">Print</button></p>
<script src="/static/js/app.js" defer></script>
</body></html>
