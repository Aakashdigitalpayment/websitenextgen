<div class="card" style="max-width:640px;margin:40px auto;text-align:center;padding:36px">
  <div style="display:grid;place-items:center;width:56px;height:56px;margin:0 auto 14px;border-radius:50%;background:var(--brand-soft);color:var(--brand)"><%- icon('shield', 'icon-lg') %></div>
  <h1 style="font-size:1.4rem"><%= title %></h1>
  <p class="muted"><b><%= t(feature.np, feature.en) %></b> <%= t('सुविधा', '') %> <%= t(need.np, need.en) %> <%= t('वा माथिको प्लानमा उपलब्ध छ। तपाईंको हालको प्लान:', 'or higher plan. Your current plan:') %> <b><%= t(plan.info.np, plan.info.en) %></b></p>
  <div class="flex gap-1 justify-center wrap mt-2">
    <a class="btn btn-primary" href="/admin/plan"><%- icon('award') %><%= t('प्लान हेर्नुहोस्', 'See plans') %></a>
    <a class="btn btn-ghost" href="/admin"><%= t('ड्यासबोर्ड', 'Dashboard') %></a>
  </div>
</div>
