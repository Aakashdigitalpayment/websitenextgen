<% const qs = new URLSearchParams(query).toString(); const here = '/admin/inbox/' + m.key + (qs ? '?' + qs : '');
   const withQ = (k, v) => { const p = new URLSearchParams(query); p.delete('page'); if (k === 'status') p.delete('bucket'); if (v === '' || v == null) p.delete(k); else p.set(k, v); const x = p.toString(); return '/admin/inbox/' + m.key + (x ? '?' + x : ''); };
   const withBucket = b => { const p = new URLSearchParams(query); p.delete('page'); p.delete('status'); p.set('bucket', b); return '/admin/inbox/' + m.key + '?' + p; };
   const LINK = { linked: ['लिंक', 'Linked', 'badge-ok'], kym_only: ['KYM मात्र', 'KYM only', 'badge-info'], no_password: ['पासवर्ड छैन', 'No password', 'badge-warn'], unlinked_member: ['लिंक छैन', 'Not linked', 'badge-bad'] };
   const colorOf = (fl, v) => { const o = (options[fl.name] || []).find(o => String(o[0]) === String(v)); return o && o[3] && o[3].color; }; %>
<div class="content-head">
  <h1><%= title %> <span class="muted" style="font-weight:400;font-size:1rem">(<%= num(pg.total) %>)</span></h1>
  <div class="flex gap-1">
    <% if (m.key === 'kyc') { %><a class="btn btn-outline btn-sm" href="/admin/kyc-risk-reviews"><%- icon('shield') %><%= t('जोखिम पुनरावलोकन', 'Risk reviews') %></a><% } %>
    <a class="btn btn-outline btn-sm" href="/admin/inbox/<%= m.key %>/export.csv?<%= qs %>"><%- icon('download') %>CSV</a>
  </div>
</div>
<% if (locals.auction) { %><div class="alert alert-info"><%= t('लिलाम', 'Auction') %>: <strong><%= t(auction.title, auction.title_en || auction.title) %></strong> · <%= statusLabel(auction.status) %> · <%= t('न्यूनतम', 'Minimum') %> रु. <%= money(auction.minimum_price) %> · <a href="/admin/r/auction_notices/<%= auction.id %>/edit"><%= t('सम्पादन', 'Edit') %></a></div><% } %>
<% if (locals.counts && statuses.length) { %>
<div class="tabs" aria-label="<%= t('स्थिति अनुसार', 'By status') %>">
  <a class="tab <%= !status && (!m.buckets || bucket === 'all') ? 'active' : '' %>" href="<%= m.buckets ? withBucket('all') : withQ('status', '') %>"><%= t('सबै', 'All') %> <b><%= num(counts.total) %></b></a>
  <% if (m.buckets) { Object.entries(m.buckets).forEach(([b, list]) => { %><a class="tab <%= !status && bucket === b ? 'active' : '' %>" href="<%= withBucket(b) %>"><%= b === 'active' ? t('चालु', 'Active') : t('टुङ्गिएका', 'Done') %> <b><%= num(list.reduce((a, s) => a + (counts.by[s] || 0), 0)) %></b></a><% }) } %>
  <% statuses.forEach(s => { if (!counts.by[s] && status !== s) return; %><a class="tab <%= status === s ? 'active' : '' %>" href="<%= withQ('status', s) %>"><%= statusLabel(s) %> <b><%= num(counts.by[s] || 0) %></b></a><% }) %>
  <% if (counts.unread != null && hasRead) { %><a class="tab <%= query.unread === '1' ? 'active' : '' %>" href="<%= withQ('unread', query.unread === '1' ? '' : '1') %>"><%= t('नपढिएका', 'Unread') %> <b><%= num(counts.unread) %></b></a><% } %>
  <% if (counts.pending_amount != null) { %><span class="tab" style="cursor:default"><%= t('बाँकी रकम', 'Pending amount') %> <b>रु. <%= money(counts.pending_amount) %></b></span><% } %>
</div>
<% } %>
<form class="toolbar" method="get">
  <input class="input" name="q" value="<%= q %>" placeholder="<%= t('नाम, फोन, ट्र्याकिङ…', 'Name, phone, tracking…') %>">
  <% if (statuses.length) { %><select class="select" name="status" data-autosubmit><option value=""><%= t('सबै स्थिति', 'All statuses') %></option><% statuses.forEach(s => { %><option value="<%= s %>" <%= status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %></select><% } %>
  <% if (m.buckets && !status) { %><input type="hidden" name="bucket" value="<%= bucket %>"><% } %>
  <% (m.filters || []).forEach(f => { const opts = f.options || options[f.optionsFromField] || []; if (!opts.length) return; %><select class="select" name="<%= f.name %>" data-autosubmit aria-label="<%= t(...f.label) %>"><option value=""><%= t(...f.label) %></option><% opts.forEach(o => { %><option value="<%= o[0] %>" <%= String(filterValues[f.name] ?? '') === String(o[0]) ? 'selected' : '' %>><%= t(o[1], o[2]) %></option><% }) %></select><% }) %>
  <% if (hasRead) { %><label class="choice" style="padding:6px 10px"><input type="checkbox" name="unread" value="1" <%= query.unread === '1' ? 'checked' : '' %> data-autosubmit> <%= t('नपढिएका', 'Unread') %></label><% } %>
  <input class="input" type="date" name="from" value="<%= query.from || '' %>" title="From" style="min-width:0">
  <input class="input" type="date" name="to" value="<%= query.to || '' %>" title="To" style="min-width:0">
  <button class="btn btn-outline"><%- icon('search') %></button>
</form>
<% if (!rows.length) { %><div class="empty"><%= t('कुनै आवेदन छैन।', 'No submissions.') %></div><% } else { %>
<% if (canMutate) { %><form method="post" action="/admin/inbox/<%= m.key %>/bulk" id="bulkForm">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_back" value="<%= here %>">
  <div class="flex gap-1 items-center wrap mb-2">
    <label class="choice" style="padding:6px 10px"><input type="checkbox" data-check-all="ids"> <%= t('सबै', 'All') %></label>
    <select class="select" name="action" style="max-width:240px" aria-label="<%= t('कारबाही', 'Action') %>">
      <option value=""><%= t('छानिएकामा कारबाही…', 'With selected…') %></option>
      <% statuses.forEach(s => { if (m.key === 'membership' && s === 'approved') return; %><option value="status:<%= s %>"><%= t('स्थिति', 'Status') %>: <%= statusLabel(s) %></option><% }) %>
      <% if (hasRead) { %><option value="read"><%= t('पढेको चिन्ह', 'Mark read') %></option><option value="unread"><%= t('नपढेको चिन्ह', 'Mark unread') %></option><% } %>
      <% if (canDelete) { %><option value="delete"><%= t('हटाउनुहोस्', 'Delete') %></option><% } %>
    </select>
    <button class="btn btn-outline btn-sm" data-confirm="<%= t('छानिएका पङ्क्तिमा लागू गर्ने?', 'Apply to the selected rows?') %>"><%= t('लागू गर्नुहोस्', 'Apply') %></button>
  </div>
</form><% } %>
<div class="table-wrap"><table class="table">
  <thead><tr><th style="width:28px"></th><% if (!m.noTracking) { %><th><%= t('ट्र्याकिङ', 'Tracking') %></th><% } %><% m.fields.filter(f => f.show).forEach(fl => { %><th><%= t(fl.label[0], fl.label[1]) %></th><% }) %><% if (m.key === 'kyc') { %><th><%= t('सदस्य लिंक', 'Member link') %></th><% } %><% if (statuses.length) { %><th><%= t('स्थिति', 'Status') %></th><% } %><th><%= t('मिति', 'Date') %></th><th></th></tr></thead>
  <tbody><% rows.forEach(row => { %>
    <tr style="<%= hasRead && !row.is_read ? 'font-weight:500' : '' %>">
      <td><% if (canMutate) { %><input type="checkbox" name="ids" value="<%= row.id %>" form="bulkForm" aria-label="#<%= row.id %>"><% } %></td>
      <% if (!m.noTracking) { %><td><a href="/admin/inbox/<%= m.key %>/<%= row.id %>" class="small" style="font-family:ui-monospace,monospace"><%= row.tracking_id || '#' + row.id %></a></td><% } %>
      <% m.fields.filter(f => f.show).forEach((fl, i) => { let v = row[fl.name]; const color = colorOf(fl, v); const o = (options[fl.name] || []).find(o => String(o[0]) === String(v)); if (o) v = t(o[1], o[2]); %>
        <td><% if (i === 0 && m.noTracking) { %><a href="/admin/inbox/<%= m.key %>/<%= row.id %>" style="color:var(--text)"><%= v %></a><% } else if (color) { %><span class="badge" style="background:color-mix(in srgb, <%= color %> 14%, transparent);color:<%= color %>"><%= v %></span><% } else { %><%= fl.format === 'money' ? money(v) : fl.type === 'date' ? (v ? bsDate(v) : '') : util.excerpt(v, 50) %><% } %></td>
      <% }) %>
      <% if (m.key === 'kyc') { const L = LINK[(locals.linkStatus || {})[row.id]]; %><td><% if (L) { %><span class="badge <%= L[2] %>"><%= t(L[0], L[1]) %></span><% } %></td><% } %>
      <% if (statuses.length && !canMutate) { %><td><span class="badge <%= row.status === 'pending' ? 'badge-warn' : /accepted/.test(row.status) ? 'badge-ok' : /rejected/.test(row.status) ? 'badge-bad' : 'badge-info' %>"><%= statusLabel(row.status) %></span></td><% } else if (statuses.length) { %><td>
        <form method="post" action="/admin/inbox/<%= m.key %>/<%= row.id %>/status" class="quick-status">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="quick" value="1"><input type="hidden" name="_back" value="<%= here %>">
          <select class="select select-sm badge-select <%= row.status === 'pending' ? 'badge-warn' : /approved|completed|resolved|selected|confirmed|disbursed|accepted|paid/.test(row.status) ? 'badge-ok' : /rejected|cancelled/.test(row.status) ? 'badge-bad' : 'badge-info' %>" name="status" data-autosubmit aria-label="<%= t('स्थिति', 'Status') %>">
            <% statuses.forEach(s => { if (m.key === 'membership' && s === 'approved' && row.status !== 'approved') return; %><option value="<%= s %>" <%= row.status === s ? 'selected' : '' %>><%= statusLabel(s) %></option><% }) %>
          </select>
          <noscript><button class="btn btn-ghost btn-sm">✓</button></noscript>
        </form>
      </td><% } %>
      <td class="small faint"><%= bsDate(row.created_at) %></td>
      <td><div class="row-actions">
        <% if (hasRead && canMutate) { %><form method="post" action="/admin/inbox/<%= m.key %>/<%= row.id %>/read"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input type="hidden" name="_back" value="<%= here %>"><input type="hidden" name="read" value="<%= row.is_read ? '0' : '1' %>"><button class="btn btn-ghost btn-sm btn-icon" title="<%= row.is_read ? t('नपढेको चिन्ह', 'Mark unread') : t('पढेको चिन्ह', 'Mark read') %>"><%- icon(row.is_read ? 'mail' : 'check') %></button></form><% } %>
        <a class="btn btn-ghost btn-sm btn-icon" href="/admin/inbox/<%= m.key %>/<%= row.id %>/print" target="_blank" rel="noopener" title="<%= t('प्रिन्ट', 'Print') %>"><%- icon('file') %></a>
      </div></td>
    </tr>
  <% }) %></tbody>
</table></div>
<%- include('../partials/pagination', { pg }) %>
<% } %>
<style>.quick-status .badge-select{border:0;border-radius:999px;padding:2px 26px 2px 10px;font-size:.78rem;font-weight:500;min-width:0;width:auto;height:auto}</style>
<script src="/static/js/admin-inbox.js" defer></script>
