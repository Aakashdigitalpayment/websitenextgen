<% const isAdmin = roleLevel(admin.role) >= 3; %>
<div class="content-head"><div><h1><%= title %></h1><div class="small muted"><%= t('साझेदार संस्थाले /verify पृष्ठमा सदस्य प्रमाणित गरेपछि डेस्क PIN हालेर सेवा लग गर्छन्।', 'After verifying a member card on /verify, a partner desk logs the service with its PIN.') %></div></div>
  <div class="flex gap-1 wrap"><a class="btn btn-outline btn-sm" href="/verify" target="_blank" rel="noopener"><%- icon('shield') %><%= t('प्रमाणीकरण पृष्ठ', 'Verify page') %></a><a class="btn btn-outline btn-sm" href="/admin/r/partner_facilities"><%- icon('edit') %><%= t('साझेदार सुविधा', 'Partner facilities') %></a></div></div>
<div class="card" style="padding:0"><div class="table-wrap"><table class="table"><thead><tr><th><%= t('साझेदार', 'Partner') %></th><th><%= t('डेस्क कोड', 'Desk code') %></th><th><%= t('प्रयोग', 'Uses') %></th><th><%= t('PIN', 'PIN') %></th></tr></thead><tbody>
  <% rows.forEach(p => { %><tr style="<%= Number(p.is_active) ? '' : 'opacity:.55' %>">
    <td><a href="/admin/r/partner_facilities/<%= p.id %>/edit"><%= lang === 'en' && p.partner_name_en ? p.partner_name_en : p.partner_name %></a><div class="small faint"><%= p.facility_type || '' %><%= p.vendor_id ? ' · ' + t('भेन्डरबाट', 'from vendor') : '' %></div></td>
    <td><code><%= p.partner_code || '—' %></code></td>
    <td><a href="?partner=<%= p.id %>#logs"><%= num(p.uses) %></a> <span class="small faint">(<%= num(p.taken) %> <%= t('सेवा', 'served') %>)</span><% if (p.last_used) { %><div class="small faint"><%= bsDate(p.last_used) %></div><% } %></td>
    <td><span class="badge <%= p.has_pin ? 'badge-ok' : '' %>"><%= p.has_pin ? t('सेट छ', 'Set') : t('छैन', 'None') %></span>
      <% if (isAdmin) { %><form method="post" action="/admin/partners/<%= p.id %>/pin" class="flex gap-1 mt-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" type="password" name="pin" autocomplete="new-password" inputmode="numeric" placeholder="<%= t('नयाँ PIN', 'New PIN') %>" style="max-width:120px" aria-label="PIN"><button class="btn btn-ghost btn-sm"><%= t('सेट', 'Set') %></button><% if (p.has_pin) { %><button class="btn btn-ghost btn-sm" name="clear" value="1" formnovalidate data-confirm="<%= t('PIN हटाउने? त्यसपछि PIN बिना लग हुन्छ।', 'Clear the PIN? Logging will no longer need it.') %>"><%= t('हटाउनुहोस्', 'Clear') %></button><% } %></form><% } %></td></tr><% }) %>
  <% if (!rows.length) { %><tr><td colspan="4" class="muted small"><%= t('साझेदार सुविधा छैन।', 'No partner facilities yet.') %></td></tr><% } %>
</tbody></table></div></div>

<div class="card mt-3" style="padding:0" id="logs"><div class="flex justify-between items-center wrap gap-1" style="padding:16px 20px 0"><h3 class="mb-0"><%= t('सेवा लग', 'Service log') %><%= partnerId ? ' — ' + ((rows.find(r => r.id === partnerId) || {}).partner_name || '') : '' %></h3>
  <div class="flex gap-1"><% if (partnerId) { %><a class="btn btn-ghost btn-sm" href="/admin/partners#logs"><%= t('सबै', 'All') %></a><% } %><a class="btn btn-soft btn-sm" href="?<%= partnerId ? 'partner=' + partnerId + '&' : '' %>export=csv"><%- icon('download') %>CSV</a></div></div>
  <div class="table-wrap"><table class="table"><thead><tr><th><%= t('मिति', 'Date') %></th><th><%= t('सदस्य', 'Member') %></th><th><%= t('साझेदार', 'Partner') %></th><th><%= t('सेवा', 'Service') %></th><th><%= t('स्थिति', 'Status') %></th></tr></thead><tbody>
    <% logs.forEach(l => { %><tr><td class="small faint"><%= bsDate(l.created_at) %> <%= new Date(l.created_at).toTimeString().slice(0, 5) %></td><td><%= l.name_np || l.name || '—' %><div class="small faint"><%= l.sadasyata_number || l.member_card_no || '' %></div></td><td class="small"><%= l.partner_name %></td><td class="small"><%= l.service_name || '—' %><% if (l.service_note) { %><div class="faint"><%= l.service_note %></div><% } %></td><td><span class="badge <%= Number(l.service_taken) ? 'badge-ok' : '' %>"><%= Number(l.service_taken) ? t('सेवा लिइयो', 'Service taken') : t('भ्रमण मात्र', 'Visit only') %></span></td></tr><% }) %>
    <% if (!logs.length) { %><tr><td colspan="5" class="muted small"><%= t('अहिलेसम्म सेवा लग छैन।', 'No services logged yet.') %></td></tr><% } %>
  </tbody></table></div></div>
