<div class="content-head"><h1><%= title %></h1><div class="flex gap-1"><a class="btn btn-outline btn-sm" href="/admin/hrm/directory.csv"><%- icon('download') %>CSV</a><a class="btn btn-primary" href="/admin/r/hrm_employees/new"><%- icon('plus') %><%= t('नयाँ कर्मचारी', 'New employee') %></a></div></div>
<div class="kpis">
  <a class="kpi card-link" href="/admin/r/hrm_employees"><div class="l"><%= t('कार्यरत', 'Active') %></div><div class="v"><%= num(counts.active || 0) %></div></a>
  <div class="kpi"><div class="l"><%= t('आज बिदामा', 'On leave today') %></div><div class="v"><%= num(onLeave.length) %></div></div>
  <div class="kpi"><div class="l"><%= t('करार सकिन लागेको', 'Contracts ending (45 days)') %></div><div class="v"><%= num(expiringContracts.length) %></div></div>
  <div class="kpi"><div class="l"><%= t('सेवा छाडेका', 'Left') %></div><div class="v"><%= num((counts.resigned || 0) + (counts.retired || 0) + (counts.terminated || 0)) %></div></div>
</div>
<div class="grid grid-2">
  <div class="card"><h3><%= t('विभाग अनुसार', 'By department') %></h3>
    <% const max = Math.max(1, ...byDept.map(d => d.n)); %>
    <% if (!byDept.length) { %><p class="muted small"><%= t('कर्मचारी थपिएको छैन।', 'No employees yet.') %></p><% } %>
    <% byDept.forEach(d => { %><div class="mb-1"><div class="flex justify-between small"><span><%= d.name %></span><span><%= num(d.n) %></span></div><div style="height:6px;background:var(--surface-2);border-radius:3px"><div style="height:6px;width:<%= Math.round(d.n / max * 100) %>%;background:var(--brand);border-radius:3px"></div></div></div><% }) %>
  </div>
  <div class="card"><h3><%= t('ध्यान दिनुपर्ने', 'Needs attention') %></h3>
    <ul class="list small">
      <% expiringContracts.forEach(c => { %><li class="list-item"><span class="badge badge-warn"><%= t('करार', 'Contract') %></span><a class="grow" href="/admin/hrm/employees/<%= c.employee_id %>"><%= c.full_name %></a><span><%= bsDate(c.end_date) %></span></li><% }) %>
      <% expiringDocs.forEach(d => { %><li class="list-item"><span class="badge <%= d.expires_on < new Date().toISOString().slice(0,10) ? 'badge-bad' : 'badge-warn' %>"><%= t('कागजात', 'Document') %></span><a class="grow" href="/admin/hrm/employees/<%= d.employee_id %>"><%= d.full_name %> — <%= d.title %></a><span><%= bsDate(d.expires_on) %></span></li><% }) %>
      <% onLeave.forEach(l => { %><li class="list-item"><span class="badge badge-info"><%= t('बिदा', 'Leave') %></span><a class="grow" href="/admin/hrm/employees/<%= l.employee_id %>"><%= l.full_name %></a><span><%= t('सम्म ', 'until ') %><%= bsDate(l.to_date) %></span></li><% }) %>
      <% if (!expiringContracts.length && !expiringDocs.length && !onLeave.length) { %><li class="list-item muted"><%= t('केही बाँकी छैन।', 'All clear.') %></li><% } %>
    </ul>
  </div>
</div>
<% if (recentJoins.length) { %><div class="card mt-3"><h3><%= t('हालै नियुक्त', 'Recently joined') %></h3><div class="flex gap-1 wrap"><% recentJoins.forEach(e => { %><a class="badge badge-brand" href="/admin/hrm/employees/<%= e.id %>"><%= e.full_name %> · <%= bsDate(e.join_date) %></a><% }) %></div></div><% } %>
