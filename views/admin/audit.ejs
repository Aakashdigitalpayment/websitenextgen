<div class="content-head"><h1><%= title %> <span class="muted small">(<%= num(pg.total) %>)</span></h1><a class="btn btn-outline btn-sm" href="/admin/audit?<%= qs ? qs + '&' : '' %>format=csv"><%- icon('download') %>CSV</a></div>
<form class="toolbar wrap" method="get">
  <select class="select" name="actor" aria-label="<%= t('प्रशासक', 'Admin') %>"><option value=""><%= t('सबै प्रशासक', 'All admins') %></option><% actors.forEach(a => { %><option value="<%= a.actor_id %>" <%= f.actor === a.actor_id ? 'selected' : '' %>><%= a.actor_name || '#' + a.actor_id %></option><% }) %></select>
  <select class="select" name="action" aria-label="<%= t('कार्य', 'Action') %>"><option value=""><%= t('सबै कार्य', 'All actions') %></option><% actions.forEach(a => { %><option <%= f.action === a ? 'selected' : '' %>><%= a %></option><% }) %></select>
  <select class="select" name="entity" aria-label="<%= t('विषय', 'Entity') %>"><option value=""><%= t('सबै विषय', 'All entities') %></option><% entities.forEach(a => { %><option <%= f.entity === a ? 'selected' : '' %>><%= a %></option><% }) %></select>
  <input class="input" name="from" value="<%= f.from %>" placeholder="<%= t('देखि (वि.सं./AD)', 'From (BS/AD)') %>" aria-label="from">
  <input class="input" name="to" value="<%= f.to %>" placeholder="<%= t('सम्म (वि.सं./AD)', 'To (BS/AD)') %>" aria-label="to">
  <input class="input" name="q" value="<%= f.q %>" placeholder="<%= t('खोज्नुहोस्…', 'Search…') %>">
  <button class="btn btn-outline"><%- icon('search') %></button><% if (qs) { %><a class="btn btn-ghost" href="/admin/audit"><%= t('हटाउनुहोस्', 'Clear') %></a><% } %>
</form>
<div class="table-wrap"><table class="table"><thead><tr><th><%= t('समय', 'When') %></th><th><%= t('को', 'Who') %></th><th><%= t('कार्य', 'Action') %></th><th><%= t('विवरण', 'Details') %></th><th>IP</th></tr></thead><tbody>
  <% rows.forEach(a => { %><tr><td class="small"><%= bsDate(a.created_at) %> <span class="faint"><%= new Date(a.created_at).toTimeString().slice(0, 5) %></span></td><td><%= a.actor_name || '' %> <span class="faint small"><%= a.actor_type %></span></td><td><span class="badge"><%= a.action %></span><% if (a.id < 0) { %> <span class="badge"><%= t('पुरानो', 'legacy') %></span><% } %></td>
    <td class="small"><%= a.entity_type || '' %><%= a.entity_id ? ' #' + a.entity_id : '' %> <%= a.summary || '' %>
      <% if (a.old_values || a.new_values) { %><details><summary><%= t('परिवर्तन', 'Changes') %></summary><pre class="log-stack"><% if (a.old_values) { %><%= t('पहिले', 'Before') %>: <%= a.old_values %>
<% } %><% if (a.new_values) { %><%= t('पछि', 'After') %>: <%= a.new_values %><% } %></pre></details><% } %></td><td class="small faint"><%= a.ip_address || '' %></td></tr><% }) %>
  <% if (!rows.length) { %><tr><td colspan="5" class="muted"><%= t('कुनै रेकर्ड छैन।', 'Nothing found.') %></td></tr><% } %>
</tbody></table></div>
<%- include('../partials/pagination', { pg }) %>
