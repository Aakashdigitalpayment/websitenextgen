<% const isAdmin = roleLevel(admin.role) >= 3; const months = lang === 'en' ? nd.MONTHS_EN : nd.MONTHS_NP; const L = l => t(l[0], l[1]); %>
<div class="content-head"><div><div class="crumbs"><a href="/admin/institutional-welfare"><%= t('राहत', 'Welfare') %></a> / <a href="/admin/r/institutional_profile/<%= p.id %>/edit"><%= num(p.fiscal_year) %></a></div><h1><%= title %></h1>
  <div class="small muted"><%= p.report_month ? months[p.report_month - 1] : t('वार्षिक', 'Annual') %><% if (bounds) { %> · <%= bsDate(bounds.from) %> — <%= bsDate(bounds.to) %><% } %> · <span class="badge <%= hasSaved ? 'badge-ok' : '' %>"><%= hasSaved ? t('सुरक्षित snapshot', 'Saved snapshot') : t('स्वचालित (सुरक्षित छैन)', 'Automatic (not saved)') %></span></div></div></div>
<% if (!bounds) { %><div class="alert alert-warn"><%= t('आर्थिक वर्ष/महिना मिलेन (उदा. 2082/83)।', 'Fiscal year/month could not be read (e.g. 2082/83).') %></div><% } %>
<form method="post" action="/admin/institutional-welfare/<%= p.id %>" class="card" style="padding:0">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="table-wrap"><table class="table"><thead><tr><th><%= t('राहत प्रकार', 'Type') %></th><th class="num"><%= t('अघिल्लो कुल', 'Previous total') %></th><th><%= t('यो महिना संख्या', 'Month count') %></th><th><%= t('यो महिना रकम', 'Month amount') %></th><th><%= t('कुल संख्या', 'Cumulative count') %></th><th><%= t('कुल रकम', 'Cumulative amount') %></th></tr></thead><tbody>
    <% suggested.forEach(r => { const s = saved[r.slug]; const v = k => s ? s[k] : r[k]; %><tr>
      <td><input type="hidden" name="welfare_slug" value="<%= r.slug %>"><span style="display:inline-block;width:10px;height:10px;border-radius:50%;background:<%= /^#[0-9a-f]{3,8}$/i.test(r.color) ? r.color : '#6b7280' %>"></span> <%= L(r.label) %></td>
      <td class="num small"><%= num(r.prev_count) %> · <%= money(r.prev_amount) %></td>
      <% ['month_count', 'month_amount', 'cum_count', 'cum_amount'].forEach(k => { %><td><input class="input" type="number" min="0" step="<%= k.endsWith('amount') ? '0.01' : '1' %>" name="<%= k %>" value="<%= v(k) %>" style="max-width:130px" aria-label="<%= k %>" <%= isAdmin ? '' : 'disabled' %>><% if (s && Number(s[k]) !== Number(r[k])) { %><div class="small faint"><%= t('स्वचालित', 'auto') %>: <%= r[k] %></div><% } %></td><% }) %></tr><% }) %>
    <% if (!suggested.length) { %><tr><td colspan="6" class="muted small"><%= t('राहत प्रकार वा दाबी छैन।', 'No welfare types or claims.') %></td></tr><% } %>
  </tbody></table></div>
  <% if (isAdmin) { %><div class="form-actions" style="padding:0 20px 16px"><button class="btn btn-primary"><%- icon('check') %><%= t('सुरक्षित गर्नुहोस्', 'Save') %></button><% if (hasSaved) { %><button class="btn btn-ghost" name="action" value="reset" data-confirm="<%= t('सुरक्षित snapshot हटाएर स्वचालित गणनामा फर्कने?', 'Remove the saved snapshot and go back to automatic totals?') %>"><%= t('स्वचालितमा फर्काउनुहोस्', 'Reset to automatic') %></button><% } %></div><% } %>
</form>
<p class="small muted mt-2"><%= t('स्वचालित: यो महिना = महिनाभित्र स्वीकृत दाबी; कुल = अघिल्लो सुरक्षित snapshot + यो महिना, नभए Opening + महिनाअन्तसम्मका सबै स्वीकृत दाबी।', 'Automatic: month = claims approved within the month; cumulative = previous saved snapshot + month, otherwise opening + every approved claim up to month end.') %></p>
