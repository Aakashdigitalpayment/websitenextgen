<div class="content-head"><h1><%= title %></h1></div>
<% if (temp) { %><div class="alert alert-success"><%= t('अस्थायी पासवर्ड (सदस्यलाई फोनमा भन्नुहोस्): ', 'Temporary password (share with the member by phone): ') %><code style="font-size:1rem"><%= temp.temp %></code></div><% } %>
<% if (!rows.length) { %><div class="empty"><%= t('कुनै अनुरोध छैन।', 'No requests.') %></div><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th><%= t('सदस्य', 'Member') %></th><th><%= t('फोन', 'Phone') %></th><th><%= t('मिति', 'Requested') %></th><th><%= t('स्थिति', 'Status') %></th><th></th></tr></thead><tbody>
  <% rows.forEach(r => { %><tr><td><a href="/admin/members/<%= r.member_id %>"><%= r.name %></a><div class="small faint"><%= r.sadasyata_number || '' %></div></td><td><%= r.phone || '' %></td><td class="small"><%= bsDate(r.requested_at) %></td><td><span class="badge <%= r.status === 'pending' ? 'badge-warn' : 'badge-ok' %>"><%= r.status %></span></td>
    <td class="text-right"><% if (r.status === 'pending') { %><form method="post" action="/admin/password-requests/<%= r.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-soft btn-sm" data-confirm="<%= t('सदस्यको फोन नम्बर प्रमाणित गर्नुभयो?', 'Have you verified the member by phone?') %>"><%= t('अस्थायी पासवर्ड दिने', 'Issue temp password') %></button></form><% } %></td></tr><% }) %>
</tbody></table></div><% } %>
