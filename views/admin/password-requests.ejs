<div class="content-head"><h1><%= title %></h1><a class="btn btn-outline btn-sm" href="/admin/member-portal"><%- icon('inbox') %><%= t('सदस्य पोर्टल', 'Member portal') %></a></div>
<p class="small muted"><%= t('सदस्यले OTP (SMS/इमेल) बाट आफैं पासवर्ड बदल्न सक्छन्। SMS/इमेल नहुँदा वा सदस्यले रोजेमा अनुरोध यहाँ आउँछ। सदस्यलाई फोनमा प्रमाणित गरेर मात्र पासवर्ड दिनुहोस्।', 'Members can reset their own password with an OTP (SMS/email). Requests land here when that is not possible or the member prefers the office. Verify the member by phone before giving a password.') %></p>
<% if (temp) { %><div class="alert alert-success"><%= t('अस्थायी पासवर्ड (सदस्यलाई फोनमा भन्नुहोस्): ', 'Temporary password (share with the member by phone): ') %><code style="font-size:1rem"><%= temp.temp %></code></div><% } %>
<% if (!rows.length) { %><div class="empty"><%= t('कुनै अनुरोध छैन।', 'No requests.') %></div><% } else { %>
<div class="table-wrap"><table class="table"><thead><tr><th><%= t('सदस्य', 'Member') %></th><th><%= t('फोन', 'Phone') %></th><th><%= t('मिति', 'Requested') %></th><th><%= t('स्थिति', 'Status') %></th><th></th></tr></thead><tbody>
  <% rows.forEach(r => { %><tr><td><a href="/admin/members/<%= r.member_id %>"><%= r.name_np || r.name %></a><div class="small faint"><%= r.sadasyata_number || '' %></div></td><td><%= r.phone || '' %></td><td class="small"><%= bsDate(r.requested_at) %><% if (r.resolved_at) { %><div class="faint">→ <%= bsDate(r.resolved_at) %></div><% } %></td>
    <td><span class="badge <%= r.status === 'pending' ? 'badge-warn' : r.status === 'rejected' ? 'badge-bad' : 'badge-ok' %>"><%= statusLabel(r.status) %></span><% if (r.admin_note) { %><div class="small faint"><%= r.admin_note %></div><% } %></td>
    <td class="text-right"><% if (r.status === 'pending') { %>
      <div class="stack" style="gap:6px;align-items:flex-end">
        <form method="post" action="/admin/password-requests/<%= r.id %>/resolve"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-soft btn-sm" data-confirm="<%= t('सदस्यको फोन नम्बर प्रमाणित गर्नुभयो?', 'Have you verified the member by phone?') %>"><%= t('अस्थायी पासवर्ड दिने', 'Issue temp password') %></button></form>
        <details><summary class="btn btn-ghost btn-sm"><%= t('पासवर्ड सेट गर्ने', 'Set a password') %></summary>
          <form method="post" action="/admin/password-requests/<%= r.id %>/set" class="mt-1 stack" style="gap:6px"><input type="hidden" name="_csrf" value="<%= csrfToken %>">
            <input class="input" type="password" name="new_password" minlength="8" required autocomplete="new-password" placeholder="<%= t('नयाँ पासवर्ड (कम्तीमा ८)', 'New password (min 8)') %>">
            <label class="choice small"><input type="checkbox" name="must_change" value="1" checked> <%= t('अर्को लगइनमा बदल्न लगाउने', 'Must change at next sign-in') %></label>
            <% if (r.phone) { %><label class="choice small"><input type="checkbox" name="sms" value="1"> <%= t('SMS सूचना (पासवर्ड बिना)', 'SMS notice (without the password)') %></label><% } %>
            <button class="btn btn-primary btn-sm"><%= t('सेट गरी सूचना पठाउने', 'Set & notify') %></button></form></details>
        <details><summary class="btn btn-ghost btn-sm"><%= t('अस्वीकृत', 'Reject') %></summary>
          <form method="post" action="/admin/password-requests/<%= r.id %>/reject" class="mt-1 flex gap-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><input class="input" name="note" placeholder="<%= t('कारण', 'Reason') %>" maxlength="500"><button class="btn btn-outline btn-sm"><%= t('पठाउनुहोस्', 'Send') %></button></form></details>
      </div><% } %></td></tr><% }) %>
</tbody></table></div><% } %>
