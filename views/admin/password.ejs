<div class="content-head"><h1><%= title %></h1></div>
<form class="form-card maxw-sm" method="post" action="/admin/password">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <div class="stack">
    <% [['current', t('हालको पासवर्ड', 'Current password'), 'current-password'], ['password', t('नयाँ पासवर्ड (कम्तीमा १०)', 'New password (min 10)'), 'new-password'], ['confirm', t('फेरि नयाँ पासवर्ड', 'Confirm new password'), 'new-password']].forEach(([n, l, ac]) => { %>
      <div class="field <%= errors[n] ? 'has-error' : '' %>"><label><%= l %></label><input class="input" type="password" name="<%= n %>" autocomplete="<%= ac %>" required><% if (errors[n]) { %><div class="field-error"><%= errors[n] %></div><% } %></div>
    <% }) %>
    <button class="btn btn-primary"><%= t('परिवर्तन गर्नुहोस्', 'Change password') %></button>
  </div>
</form>
