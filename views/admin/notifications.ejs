<div class="content-head"><h1><%= title %></h1><div class="flex gap-1"><a class="btn btn-outline btn-sm" href="/admin/settings?tab=notify"><%- icon('settings') %><%= t('SMS/इमेल सेटिङ', 'SMS/email settings') %></a><a class="btn btn-outline btn-sm" href="/admin/r/notification_templates"><%- icon('file') %><%= t('ढाँचा', 'Templates') %></a></div></div>
<div class="grid grid-2 mb-3">
  <form class="card" method="post" action="/admin/notifications/test">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3><%= t('परीक्षण पठाउनुहोस्', 'Send a test') %></h3>
    <div class="form-grid">
      <div class="field"><label><%= t('माध्यम', 'Channel') %></label><select class="select" name="channel"><option value="sms">SMS</option><option value="email"><%= t('इमेल', 'Email') %></option></select></div>
      <div class="field"><label><%= t('फोन वा इमेल', 'Phone or email') %></label><input class="input" name="to" required></div>
    </div>
    <button type="submit" class="btn btn-primary mt-2"><%= t('पठाउनुहोस्', 'Send test') %></button>
  </form>
  <form class="card" method="post" action="/admin/notifications/push">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3><%= t('सदस्यलाई सूचना', 'Notify members') %> <span class="badge"><%= num(subs) %> <%= t('push उपकरण', 'push devices') %></span></h3>
    <div class="stack">
      <div class="field"><label><%= t('एक सदस्य मात्र (सदस्यता नं./कार्ड/फोन; खाली = सबै)', 'One member only (member no. / card / phone; blank = everyone)') %></label><input class="input" name="target" maxlength="50" autocomplete="off"></div>
      <div class="field"><label><%= t('प्रकार', 'Type') %></label><select class="select" name="type"><option value="info"><%= t('जानकारी', 'Info') %></option><option value="success"><%= t('सफल', 'Success') %></option><option value="warning"><%= t('चेतावनी', 'Warning') %></option><option value="error"><%= t('त्रुटि', 'Error') %></option></select></div>
      <div class="field"><label><%= t('शीर्षक', 'Title') %></label><input class="input" name="title" maxlength="120" required></div>
      <div class="field"><label><%= t('सन्देश', 'Message') %></label><textarea class="textarea" name="body" rows="2" maxlength="300"></textarea></div>
      <div class="field"><label><%= t('लिङ्क (ऐच्छिक)', 'Link (optional)') %></label><input class="input" name="url" placeholder="/notices"></div>
    </div>
    <button type="submit" class="btn btn-primary mt-2" data-confirm="<%= t('सबै सदस्यलाई पठाउने?', 'Send to all members?') %>"><%- icon('bell') %><%= t('पठाउनुहोस्', 'Send') %></button>
  </form>
</div>
<div class="grid grid-2 mb-3">
  <form class="card" method="post" action="/admin/notifications/template-test">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
    <h3><%= t('ढाँचा परीक्षण', 'Test a template') %></h3>
    <div class="form-grid">
      <div class="field"><label for="tpl_id"><%= t('ढाँचा', 'Template') %></label><select class="select" id="tpl_id" name="template_id" required><option value="">—</option><% (locals.templates || []).forEach(x => { %><option value="<%= x.id %>"><%= x.event_type %> · <%= x.audience %> · <%= x.channel %></option><% }) %></select></div>
      <div class="field"><label for="tpl_to"><%= t('फोन वा इमेल', 'Phone or email') %></label><input class="input" id="tpl_to" name="to" required></div>
    </div>
    <button type="submit" class="btn btn-outline mt-2"><%= t('नमुना पठाउनुहोस्', 'Send sample') %></button>
  </form>
  <div class="card">
    <h3><%= t('Push लग (पछिल्ला ५०)', 'Push log (last 50)') %></h3>
    <form method="post" action="/admin/notifications/push/clear-expired" class="mb-1"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button type="submit" class="btn btn-ghost btn-sm" data-confirm="<%= t('९० दिनभन्दा पुराना push उपकरण हटाउने?', 'Remove push subscriptions older than 90 days?') %>"><%- icon('trash') %><%= t('पुराना उपकरण हटाउनुहोस्', 'Clear old subscriptions') %></button></form>
    <% if (!(locals.pushLog || []).length) { %><p class="muted small"><%= t('अहिलेसम्म छैन।', 'Nothing yet.') %></p><% } else { %>
    <div class="table-wrap"><table class="table"><tbody><% pushLog.forEach(l => { %><tr><td class="small"><%= bsDate(l.sent_at) %></td><td class="small"><%= l.name_np || l.name || '#' + l.member_id %></td><td class="small"><%= util.excerpt(l.title || '', 40) %></td><td><span class="badge <%= l.http_code >= 200 && l.http_code < 300 ? 'badge-ok' : 'badge-bad' %>"><%= l.http_code %></span></td></tr><% }) %></tbody></table></div><% } %>
  </div>
</div>
<h2><%= t('पठाइएको लग', 'Delivery log') %></h2>
<% if (!rows.length) { %><div class="empty mt-2"><%= t('अहिलेसम्म केही पठाइएको छैन।', 'Nothing sent yet.') %></div><% } else { %>
<div class="table-wrap mt-2"><table class="table"><thead><tr><th><%= t('समय', 'When') %></th><th><%= t('घटना', 'Event') %></th><th><%= t('माध्यम', 'Channel') %></th><th><%= t('प्राप्तकर्ता', 'To') %></th><th><%= t('स्थिति', 'Status') %></th></tr></thead><tbody>
  <% rows.forEach(r => { %><tr><td class="small"><%= bsDate(r.created_at) %> <span class="faint"><%= new Date(r.created_at).toTimeString().slice(0,5) %></span></td><td class="small"><%= r.event_type %></td><td><span class="badge"><%= r.channel %></span></td><td class="small"><%= r.recipient %><div class="faint"><%= util.excerpt(r.subject || r.message, 70) %></div></td><td><span class="badge <%= r.status === 'sent' ? 'badge-ok' : 'badge-bad' %>"><%= r.status %></span><% if (r.error_msg) { %><div class="small faint"><%= r.error_msg %></div><% } %></td></tr><% }) %>
</tbody></table></div>
<%- include('../partials/pagination', { pg }) %><% } %>
