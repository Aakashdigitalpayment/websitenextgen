<div class="content-head"><div><h1><%= title %></h1><div class="small muted"><%= t('वेबसाइट, सदस्य प्यानल र एडमिनको पूर्वनिर्धारित रूप छान्नुहोस्।', 'Choose the default look of the website, member panel and admin.') %></div></div></div>
<form class="form-card mb-3" method="post" action="/admin/theme/design">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h3><%= t('तयारी डिजाइन', 'Ready-made designs') %></h3>
  <p class="small muted"><%= t('एक क्लिकमा रङ, मेनुको स्थान, गृहपृष्ठ शैली र भाषा सेट हुन्छ।', 'One click sets colour, menu placement, home style and language.') %></p>
  <div class="palette-grid">
    <% designs.forEach(d => { %>
      <label class="palette-card" style="--sw:<%= d.color %>">
        <input type="radio" name="design" value="<%= d.key %>" <%= currentDesign === d.key ? 'checked' : '' %> required>
        <div class="palette-mock"><i></i><i></i><i style="width:70%"></i><b></b></div>
        <div class="palette-name"><%= t(d.np, d.en) %></div>
        <div class="small faint" style="margin-top:2px"><%= d.tagline %></div>
      </label>
    <% }) %>
  </div>
  <label class="check mt-2"><input type="checkbox" name="content" value="1"> <%= t('खाली खण्डहरूमा नमुना सामग्री (सेवा, ब्याजदर, FAQ, समिति, स्लाइड) पनि थप्ने', 'Also fill empty sections with starter content (services, rates, FAQ, committees, slides)') %></label>
  <div class="form-actions"><button class="btn btn-outline"><%- icon('check') %><%= t('डिजाइन लागू गर्नुहोस्', 'Apply design') %></button></div>
</form>

<form class="form-card" method="post" action="/admin/theme">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">

  <h3><%= t('संस्थाको रङ', 'Organisation colour') %></h3>
  <div class="flex gap-1 items-center wrap">
    <input class="input" type="color" name="primary_color" value="<%= pol.orgColor %>" style="width:64px;height:40px;padding:4px">
    <span class="small muted"><%= t('"संस्थाको रङ" प्यालेटमा, इमेल र मोबाइल ब्राउजरको रङमा प्रयोग हुन्छ।', 'Used by the "Organisation colour" palette, emails and the mobile browser bar.') %></span>
  </div>

  <h3 class="mt-3"><%= t('पूर्वनिर्धारित रङ (प्यालेट)', 'Default palette') %></h3>
  <div class="palette-grid">
    <% swatches.forEach(p => { %>
      <label class="palette-card" style="--sw:<%= p.color %>">
        <input type="radio" name="palette" value="<%= p.key %>" <%= pol.palette === p.key ? 'checked' : '' %>>
        <div class="palette-mock"><i></i><i></i><i style="width:70%"></i><b></b></div>
        <div class="palette-name"><%= t(p.np, p.en) %></div>
      </label>
    <% }) %>
  </div>

  <h3 class="mt-3"><%= t('पूर्वनिर्धारित मोड', 'Default mode') %></h3>
  <div class="mode-cards">
    <% modes.forEach(m => { %>
      <label class="mode-card"><input type="radio" name="mode" value="<%= m.key %>" <%= pol.mode === m.key ? 'checked' : '' %>><%- icon(m.icon) %><span><%= t(m.np, m.en) %><% if (m.key === 'system') { %><span class="small faint" style="display:block"><%= t('प्रयोगकर्ताको फोन/कम्प्युटर अनुसार', "Follows the user's phone / computer") %></span><% } %></span></label>
    <% }) %>
  </div>

  <h3 class="mt-3"><%= t('मेनुको स्थान', 'Menu placement') %></h3>
  <div class="layout-cards">
    <% L.HEADERS.forEach(h => { %>
      <label class="layout-card"><input type="radio" name="layout_header" value="<%= h.key %>" <%= lay.header === h.key ? 'checked' : '' %>>
        <span class="lmock lmock-hdr-<%= h.key %>"><i class="l"></i><i class="m"></i><i class="m"></i><i class="m"></i><i class="b"></i></span>
        <b><%= t(h.np, h.en) %></b><span class="small faint"><%= t(...h.hint) %></span></label>
    <% }) %>
  </div>

  <h3 class="mt-3"><%= t('गृहपृष्ठ शैली', 'Home page style') %></h3>
  <div class="layout-cards">
    <% L.HOMES.forEach(h => { %>
      <label class="layout-card"><input type="radio" name="layout_home" value="<%= h.key %>" <%= lay.home === h.key ? 'checked' : '' %>>
        <span class="lmock lmock-home-<%= h.key %>"><i class="tx"></i><i class="tx s"></i><i class="im"></i></span>
        <b><%= t(h.np, h.en) %></b><span class="small faint"><%= t(...h.hint) %></span></label>
    <% }) %>
  </div>

  <div class="form-grid mt-3">
    <div class="field"><label><%= t('कुनाको शैली', 'Corners') %></label>
      <select class="select" name="layout_corners"><% L.CORNERS.forEach(c => { %><option value="<%= c.key %>" <%= lay.corners === c.key ? 'selected' : '' %>><%= t(c.np, c.en) %></option><% }) %></select></div>
    <div class="field"><label><%= t('उपलब्ध भाषा', 'Languages offered') %></label>
      <select class="select" name="lang_enabled"><% L.LANGS.forEach(c => { %><option value="<%= c.key %>" <%= langEnabled === c.key ? 'selected' : '' %>><%= t(c.np, c.en) %></option><% }) %></select></div>
    <div class="field"><label><%= t('पूर्वनिर्धारित भाषा', 'Default language') %></label>
      <select class="select" name="lang_default"><option value="np" <%= langDefault === 'np' ? 'selected' : '' %>>नेपाली</option><option value="en" <%= langDefault === 'en' ? 'selected' : '' %>>English</option></select>
      <div class="field-hint"><%= t('पहिलो पटक आउने आगन्तुकले यही भाषा देख्छन्।', 'First-time visitors see this language.') %></div></div>
  </div>

  <h3 class="mt-3"><%= t('प्रयोगकर्ताको छनोट', 'User choice') %></h3>
  <label class="check"><input type="checkbox" name="allow_user" value="1" <%= pol.allowUser ? 'checked' : '' %>> <%= t('आगन्तुक, सदस्य र कर्मचारीले आफ्नो रूप आफैं परिवर्तन गर्न पाउने', 'Visitors, members and staff may change the theme for themselves') %></label>
  <div class="field-hint"><%= t('बन्द गरेमा सबैलाई माथिको पूर्वनिर्धारित रूप मात्र देखिन्छ।', 'When off, everyone sees the default above.') %></div>
  <label class="check mt-1"><input type="checkbox" name="reset_all" value="1"> <%= t('सबैको सुरक्षित छनोट हटाएर नयाँ पूर्वनिर्धारित लागू गर्ने', "Clear everyone's saved choice and apply the new default") %></label>
  <div class="field-hint"><%= t('अहिले', 'Currently') %> <%= num(counts.members) %> <%= t('सदस्य र', 'members and') %> <%= num(counts.admins) %> <%= t('कर्मचारीले आफ्नै रूप राखेका छन्।', 'staff have their own theme saved.') %></div>

  <div class="form-actions"><button class="btn btn-primary"><%- icon('check') %><%= t('सुरक्षित गर्नुहोस्', 'Save') %></button></div>
</form>
