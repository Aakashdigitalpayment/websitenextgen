<div class="content-head"><h1><%= title %></h1></div>
<% if (!enabled) { %><div class="alert alert-warn"><%- icon('alert') %><span><%= t('सर्भरमा CREDENTIALS_KEY (कम्तीमा ३२ अक्षर) सेट गरेपछि मात्र यो सुविधा चल्छ।', 'Set CREDENTIALS_KEY (min 32 characters) on the server to use this feature.') %></span></div><% } %>
<div class="alert alert-info"><%- icon('shield') %><span><%= t('पासवर्ड AES-256-GCM मा गोप्य राखिन्छ। हेर्ने/कपी गर्ने हरेक कार्य अभिलेख हुन्छ।', 'Passwords are encrypted with AES-256-GCM. Every view/copy is logged.') %></span></div>
<div class="grid" style="grid-template-columns:minmax(0,1.6fr) minmax(0,1fr);gap:20px">
  <div>
    <% if (!rows.length) { %><div class="empty"><%= t('अहिलेसम्म कुनै खाता छैन।', 'No credentials saved yet.') %></div><% } else { %>
    <div class="table-wrap"><table class="table"><thead><tr><th><%= t('साइट', 'Site') %></th><th><%= t('प्रयोगकर्ता', 'Username') %></th><th><%= t('पासवर्ड', 'Password') %></th><th></th></tr></thead><tbody>
      <% rows.forEach(c => { %><tr>
        <td><div style="font-weight:500"><%= c.site_name %></div><div class="small faint"><span class="badge"><%= c.category %></span> <% if (c.site_url) { %><a href="<%= c.site_url %>" target="_blank" rel="noopener noreferrer"><%= String(c.site_url).replace(/^https?:\/\//, '').split('/')[0] %></a><% } %></div><% if (c.notes) { %><div class="small muted"><%= c.notes %></div><% } %></td>
        <td><code><%= c.username %></code></td>
        <td><span data-pw="<%= c.id %>" style="font-family:ui-monospace,monospace">••••••••</span><% if (c.legacy) { %> <span class="badge badge-warn">legacy</span><% } %></td>
        <td><div class="row-actions">
          <button class="btn btn-ghost btn-sm" type="button" data-reveal="<%= c.id %>" data-csrf="<%= csrfToken %>"><%- icon('eye') %></button>
          <button class="btn btn-ghost btn-sm" type="button" data-copy="<%= c.id %>" data-csrf="<%= csrfToken %>">Copy</button>
          <a class="btn btn-ghost btn-sm btn-icon" href="/admin/credentials/<%= c.id %>/edit"><%- icon('edit') %></a>
          <form method="post" action="/admin/credentials/<%= c.id %>/delete"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-ghost btn-sm btn-icon" data-confirm="<%= t('हटाउने?', 'Delete?') %>"><%- icon('trash') %></button></form>
        </div></td></tr><% }) %>
    </tbody></table></div><% } %>
    <% if (logs.length) { %><h3 class="mt-3"><%= t('पछिल्ला गतिविधि', 'Recent activity') %></h3>
    <div class="table-wrap"><table class="table"><tbody><% logs.forEach(l => { %><tr><td class="small"><%= bsDate(l.created_at) %> <span class="faint"><%= new Date(l.created_at).toTimeString().slice(0,5) %></span></td><td class="small"><%= l.admin_username %></td><td><span class="badge"><%= l.action %></span></td><td class="small"><%= l.site_name || '' %></td><td class="small faint"><%= l.ip_address %></td></tr><% }) %></tbody></table></div><% } %>
  </div>
  <form class="form-card" method="post" action="/admin/credentials" autocomplete="off">
    <input type="hidden" name="_csrf" value="<%= csrfToken %>"><% if (edit) { %><input type="hidden" name="id" value="<%= edit.id %>"><% } %>
    <h3><%= edit ? t('सम्पादन', 'Edit') : t('नयाँ खाता', 'Add credential') %></h3>
    <div class="stack">
      <% [['site_name', t('नाम', 'Name'), 'text'], ['site_url', 'URL', 'url'], ['username', t('प्रयोगकर्ता नाम', 'Username'), 'text'], ['category', t('समूह', 'Category'), 'text']].forEach(([n, l, ty]) => { %>
        <div class="field"><label><%= l %></label><input class="input" name="<%= n %>" type="<%= ty %>" value="<%= edit ? (edit[n] || '') : (n === 'category' ? 'general' : '') %>" <%= n === 'site_name' || n === 'username' ? 'required' : '' %>></div>
      <% }) %>
      <div class="field"><label><%= edit ? t('नयाँ पासवर्ड (खाली = उही)', 'New password (blank = keep)') : t('पासवर्ड', 'Password') %></label><input class="input" name="password" type="password" autocomplete="new-password" <%= edit ? '' : 'required' %>></div>
      <div class="field"><label><%= t('टिप्पणी', 'Notes') %></label><textarea class="textarea" name="notes" rows="2"><%= edit ? (edit.notes || '') : '' %></textarea></div>
      <button class="btn btn-primary" <%= enabled ? '' : 'disabled' %>><%= t('सुरक्षित गर्नुहोस्', 'Save') %></button>
      <% if (edit) { %><a class="btn btn-ghost" href="/admin/credentials"><%= t('रद्द', 'Cancel') %></a><% } %>
    </div>
  </form>
</div>
