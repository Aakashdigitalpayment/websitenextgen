<div class="content-head"><div><div class="crumbs"><a href="/admin/members/import"><%= t('सदस्य CSV आयात', 'Import members') %></a></div><h1><%= title %> <span class="badge <%= job.status === 'done' ? 'badge-ok' : 'badge-warn' %>"><%= job.status %></span></h1><div class="small muted"><%= job.filename %> · <%= t('मोड', 'mode') %>: <%= job.mode %></div></div>
  <% if (job.status === 'staged' && counts.pending) { %><form method="post" action="/admin/members/import/<%= job.id %>/commit"><input type="hidden" name="_csrf" value="<%= csrfToken %>"><button class="btn btn-primary" data-confirm="<%= t(num(counts.pending) + ' row सेभ गर्ने?', 'Save ' + counts.pending + ' rows?') %>"><%- icon('check') %><%= t(num(counts.pending) + ' सदस्य सेभ गर्नुहोस्', 'Import ' + counts.pending + ' members') %></button></form><% } %>
</div>
<div class="tabs"><a class="tab <%= !filter ? 'active' : '' %>" href="?"><%= t('सबै', 'All') %></a><% Object.entries(counts).forEach(([k, n]) => { %><a class="tab <%= filter === k ? 'active' : '' %>" href="?status=<%= k %>"><%= k %> (<%= num(n) %>)</a><% }) %></div>
<% if (counts.invalid && job.status === 'staged') { %><div class="alert alert-warn"><%= t(num(counts.invalid) + ' row मा त्रुटि छ — तिनीहरू आयात हुँदैनन्। CSV सच्याएर फेरि अपलोड गर्न सकिन्छ।', counts.invalid + ' rows have errors and will not be imported. Fix the CSV and upload again if needed.') %></div><% } %>
<div class="table-wrap"><table class="table"><thead><tr><th>Row</th><th><%= t('सदस्यता नं.', 'Member no.') %></th><th><%= t('नाम', 'Name') %></th><th><%= t('मोबाइल', 'Mobile') %></th><th><%= t('इमेल', 'Email') %></th><th><%= t('स्थिति', 'Status') %></th></tr></thead><tbody>
  <% rows.forEach(r => { %><tr><td class="faint"><%= r.row_num %></td><td><%= r.sadasyata_number %></td><td><%= r.name_np || r.full_name %><% if (r.name_np && r.full_name !== r.name_np) { %><div class="small faint"><%= r.full_name %></div><% } %></td><td><%= r.mobile %></td><td class="small"><%= r.email %></td>
    <td><span class="badge <%= /created|updated/.test(r.status) ? 'badge-ok' : /invalid|failed/.test(r.status) ? 'badge-bad' : r.status === 'skipped' ? '' : 'badge-info' %>"><%= r.status %></span><% if (r.message) { %><div class="small faint"><%= r.message %></div><% } %><% if (r.member_id) { %> <a class="small" href="/admin/members/<%= r.member_id %>">→</a><% } %></td></tr><% }) %>
</tbody></table></div>
