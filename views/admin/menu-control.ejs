<div class="content-head"><h1><%= title %></h1><a class="btn btn-outline btn-sm" href="/admin/roles"><%- icon('shield') %><%= t('भूमिका र अनुमति', 'Roles & permissions') %></a></div>
<div class="alert alert-info"><%- icon('info') %><span><%= t('टिक गरिएका समूह सामान्य प्रशासकबाट लुक्छन् र URL बाट पनि खोल्न मिल्दैन; सुपर प्रशासकले सधैं सबै देख्छन्। पूर्वनिर्धारित: सबै देखिने। सुरक्षित गर्दा आफ्नो पासवर्ड चाहिन्छ।', 'Ticked groups are hidden from regular admins and blocked by URL too; superadmins always see everything. Default: all visible. Saving requires your password.') %></span></div>
<form class="form-card" method="post" action="/admin/menu-control">
  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
  <h3><%= t('लुकाउने मेनु समूह', 'Groups to hide') %> <span class="badge"><%= num(hidden.length) %> <%= t('लुकेको', 'hidden') %></span></h3>
  <div class="grid grid-3" style="gap:10px">
    <% Object.entries(groups).forEach(([key, label]) => { const on = hidden.includes(key); %>
      <label class="choice" style="<%= on ? 'border-color:var(--warn);background:var(--warn-soft)' : '' %>"><input type="checkbox" name="hidden" value="<%= key %>" <%= on ? 'checked' : '' %>> <span><b style="font-weight:500"><%= t(...label) %></b> <span class="small faint"><%= key %></span></span></label>
    <% }) %>
  </div>
  <div class="form-grid mt-2">
    <div class="field"><label for="mc_pw"><%= t('तपाईंको पासवर्ड', 'Your password') %> *</label><input class="input" type="password" id="mc_pw" name="confirm_password" required autocomplete="current-password"></div>
  </div>
  <div class="form-actions">
    <button class="btn btn-primary" name="action" value="save"><%- icon('check') %><%= t('सुरक्षित गर्नुहोस्', 'Save') %></button>
    <button class="btn btn-outline" name="action" value="reset" data-confirm="<%= t('सबै मेनु फेरि देखाउने?', 'Show all menus again?') %>"><%= t('सबै देखाउनुहोस् (Reset)', 'Show all (reset)') %></button>
  </div>
</form>
