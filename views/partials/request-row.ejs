<tr>
  <td><span class="badge"><%= t(...mod.title) %></span></td>
  <td><div class="fw-500"><% if (locals.strong) { %><a href="/member/requests/<%= mod.key %>/<%= row.id %>"><%= row.tracking_id || "#" + row.id %></a><% } else { %><%= row.tracking_id || "#" + row.id %><% } %></div><div class="small faint"><%= bsDate(row.created_at) %></div><% if (mod.key === 'membership' && row.assigned_sadasyata) { %><div class="small"><%= t('सदस्यता नं.', 'Member ID') %>: <code><%= row.assigned_sadasyata %></code></div><% } %></td>
  <td><% if (row.status) { %><span class="badge <%= row.status === 'pending' ? 'badge-warn' : /approved|completed|resolved|selected|confirmed|disbursed|accepted|paid/.test(row.status) ? 'badge-ok' : /rejected|cancelled/.test(row.status) ? 'badge-bad' : 'badge-info' %>"><%= statusLabel(row.status) %></span><% } %></td>
  <td class="small muted"><% if (locals.strong) { %><%= util.excerpt(row[mod.remarksCol], 80) %><% if (mod.attachCol && row[mod.attachCol]) { %><div><a href="/member/requests/<%= mod.key %>/<%= row.id %>/attachment"><%- icon('download') %><%= t('कार्यालयको फाइल', 'Office file') %></a></div><% } %><% } else { %><span class="faint"><%= t('तपाईंको फोनबाट पेश गरिएको। विवरण ट्र्याकरमा ट्र्याकिङ नं. र फोनबाट हेर्नुहोस्।', 'Filed with your phone. See the details in the tracker with the tracking no. and phone.') %></span><% } %></td>
</tr>
