<% const h = locals.seoHead ? seoHead(locals) : null; %>
<% if (h) { %>
  <title><%= h.title %></title>
  <meta name="description" content="<%= h.description %>">
  <% if (h.keywords) { %><meta name="keywords" content="<%= h.keywords %>"><% } %>
  <% if (h.verification) { %><meta name="google-site-verification" content="<%= h.verification %>"><% } %>
  <link rel="canonical" href="<%= seo.canonical %>">
  <% seo.alternates.forEach(([hl, href]) => { %><link rel="alternate" hreflang="<%= hl %>" href="<%= href %>">
  <% }) %>
  <meta property="og:type" content="<%= h.type %>">
  <meta property="og:title" content="<%= locals.title || h.title %>">
  <meta property="og:description" content="<%= h.description %>">
  <meta property="og:url" content="<%= seo.canonical %>">
  <meta property="og:site_name" content="<%= siteName %>">
  <meta property="og:locale" content="<%= lang === 'en' ? 'en_US' : 'ne_NP' %>">
  <meta property="og:image" content="<%= h.image %>"><meta property="og:image:width" content="1200"><meta property="og:image:height" content="630">
  <meta name="twitter:card" content="summary_large_image"><meta name="twitter:title" content="<%= locals.title || h.title %>"><meta name="twitter:description" content="<%= h.description %>"><meta name="twitter:image" content="<%= h.image %>">
  <% h.blocks.forEach(b => { %><script type="application/ld+json"><%- b %></script>
  <% }) %>
<% } else { %>
  <title><%= locals.title ? title + ' · ' : '' %><%= siteName %></title>
  <meta name="description" content="<%= locals.description || settings.meta_description || settings.about_short || siteName %>">
  <meta property="og:title" content="<%= locals.title || siteName %>">
  <meta property="og:site_name" content="<%= siteName %>">
<% } %>
