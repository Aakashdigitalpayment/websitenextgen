# Copy to .env and edit
PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://coop:coop@localhost:5432/coop
SESSION_SECRET=change-me-to-a-long-random-string
# Public base URL (used in links / QR codes)
SITE_URL=http://localhost:3000
# First super-admin created by `npm run db:seed`
ADMIN_USERNAME=admin
ADMIN_PASSWORD=ChangeMe@123
# Optional: legacy MySQL source for `npm run db:import-mysql`
MYSQL_URL=mysql://user:pass@localhost:3306/legacy_db
# Optional: folder where legacy PHP uploads live (copied as-is so old file paths keep working)
UPLOAD_DIR=uploads
# Office credential vault (min 32 chars; never change once used). Generate: openssl rand -hex 32
CREDENTIALS_KEY=
# Optional: the PHP app's CRED_MASTER_KEY, to open credentials imported from the old site
CREDENTIALS_LEGACY_KEY=
# PII at rest (citizenship numbers on KYC / loan / account / membership applications), AES-256-GCM.
# 64 hex chars (or any 32+ char secret). Empty = stored as typed. Keep an offline copy: it is the only
# way to read encrypted values back, and never change it once used. Generate: openssl rand -hex 32
PII_KEY=
# Optional: the PHP app's PII_ENC_KEY, to read pii1:/pii2: values copied from the old site
# (npm run migrate:site converts them to the new format automatically when --php-root is given)
PII_LEGACY_KEY=
# Reverse proxy in front of the app? Set so client IPs (rate limits, audit log) are read correctly:
#   loopback  (Caddy/Nginx on the same server)   1  (exactly one proxy, e.g. docker caddy)
# Leave empty when the app is reached directly — then X-Forwarded-For is ignored.
TRUST_PROXY=
# Nepal time for all dates/times
APP_TIMEZONE=Asia/Kathmandu
# Custom domains: zone for generated CNAME targets (<slug>-xxxxx.<zone>); defaults to BASE_DOMAIN.
# Needs a wildcard DNS record  *.<zone>  → this server.
CNAME_ZONE=
# Public IP(s) of this server — used to verify apex domains that use an A record instead of CNAME
SERVER_IPS=
# Development only: treat client domains as verified without DNS
SKIP_DNS_VERIFY=
