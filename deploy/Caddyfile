# Caddy reverse proxy with automatic HTTPS for every cooperative domain.
# - <slug>.coopcloud.com.np subdomains and custom domains get certificates on demand,
#   but only after the app confirms the host belongs to a tenant (ask endpoint, loopback only).
# - Replace the e-mail and, if you like, the platform host.
{
	email ops@example.com
	on_demand_tls {
		ask http://127.0.0.1:3000/__tls/allowed
	}
}

https:// {
	tls {
		on_demand
	}
	@ask path /__tls/allowed /__tls/allowed/*
	respond @ask 404
	encode zstd gzip
	request_body {
		max_size 64MB
	}
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		-Server
	}
	reverse_proxy 127.0.0.1:3000 {
		header_up X-Forwarded-Proto {scheme}
	}
}

# plain HTTP → HTTPS
http:// {
	redir https://{host}{uri} permanent
}
